---
// Páginas institucionais ficam sob demanda para refletir o conteúdo publicado
// no CMS sem precisar gerar um deploy a cada edição.
import ChurchPage from '../views/ChurchPage.astro';
import GatheringsPage from '../views/GatheringsPage.astro';
import OutreachPage from '../views/OutreachPage.astro';
import VisitPage from '../views/VisitPage.astro';
import PrivacyPage from '../views/PrivacyPage.astro';
import NotFoundView from '../views/NotFoundView.astro';
import { languages, pageIds, pathFor } from '../i18n/routes.js';

export const prerender = false;

const views = { church: ChurchPage, gatherings: GatheringsPage, outreach: OutreachPage, visit: VisitPage, privacy: PrivacyPage };
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
let match = null;

for (const lang of Object.keys(languages)) {
  for (const page of pageIds.filter((id) => id !== 'home')) {
    if (pathFor(page, lang) === pathname) match = { page, lang };
  }
}

if (!match) Astro.response.status = 404;
const View = match ? views[match.page] : NotFoundView;
const fallbackLang = pathname === '/es' || pathname.startsWith('/es/') ? 'es' : pathname === '/en' || pathname.startsWith('/en/') ? 'en' : 'pt';
---

{match ? <View lang={match.lang} /> : <View lang={fallbackLang} />}
