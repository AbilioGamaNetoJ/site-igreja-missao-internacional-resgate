        <div class="admin-editor-actions">
          <button id="btn-save-draft" class="button button-light" type="button">Salvar rascunho</button>
          <button id="btn-publish" class="button button-dark" type="button">Publicar e traduzir</button>
          <button id="btn-retranslate" class="button button-outline" type="button" hidden>Atualizar traduções</button>
