                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                      <line x1="12" y1="8" x2="16" y2="8"></line>
                      <line x1="14" y1="6" x2="14" y2="10"></line>
                    </svg>
                  </span>
                  <div>
                    <h3 class="admin-cover-heading">Inserir imagem e texto da publicação</h3>
