      <nav class="admin-mobile-nav" aria-label="Navegação principal">
        <button type="button" data-nav="list"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14M5 10h14M5 16h9M5 22h14" /></svg><span>Posts</span></button>
        <button class="admin-mobile-create" type="button" data-new-post aria-label="Nova publicação"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg><span>Novo</span></button>
        <button type="button" data-nav="profile"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M4.5 21c.8-4 3.3-6 7.5-6s6.7 2 7.5 6" /></svg><span>Perfil</span></button>
      </nav>
    </div>

    <dialog id="category-dialog" class="admin-dialog" aria-labelledby="category-dialog-title">
      <form id="category-form" novalidate>
        <h2 id="category-dialog-title">Nova categoria</h2>
        <p class="admin-dialog-lead">O nome aparece no site em cada idioma. Se deixar espanhol ou inglês em branco, usamos o nome em português.</p>
        <label class="admin-field">Nome em português
          <input id="category-name-pt" type="text" maxlength="40" autocomplete="off" />
        </label>
        <label class="admin-field">Nome em espanhol (opcional)
          <input id="category-name-es" type="text" maxlength="40" autocomplete="off" />
        </label>
        <label class="admin-field">Nome em inglês (opcional)
          <input id="category-name-en" type="text" maxlength="40" autocomplete="off" />
        </label>
        <p id="category-dialog-message" class="admin-form-message" role="alert"></p>
        <div class="admin-dialog-actions">
          <button id="category-cancel" class="button button-outline" type="button">Cancelar</button>
          <button id="category-save" class="button button-dark" type="submit">Salvar categoria</button>
        </div>
      </form>
    </dialog>

    <p class="admin-status" id="status" role="status" aria-live="polite"></p>

    <script>
      import { createClient } from '@supabase/supabase-js';

      const $ = (selector) => document.querySelector(selector);
      const FIELDS = ['title', 'excerpt', 'bible_reference', 'body', 'seo_title', 'seo_description'];
      const LANGS = ['pt', 'es', 'en'];

      const supabaseUrl = document.body.dataset.supabaseUrl;
      const supabaseAnon = document.body.dataset.supabaseAnon;
      const configured = Boolean(supabaseUrl && supabaseAnon);
      const supabase = configured ? createClient(supabaseUrl, supabaseAnon) : null;

      let editing = null; // { id, slug, sourceLang, status, publishedAt, coverImage, translations: {pt,es,en} }
      let statusTimer = null;
      let currentUser = null;

      const VIEW_DETAILS = {
        list: ['Blog', 'Publicações'],
        editor: ['Blog', 'Editor'],
        profile: ['Conta', 'Meu perfil'],
      };

      const slugify = (text) =>
        text
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 80);

      function setGeneratedSlug(title) {
        const slug = slugify(title);
        editing.slug = slug;
        $('#slug').value = slug;
      }

      async function resolveAvailableSlug(base) {
        if (!base || editing?.id) return base;
        const { data, error } = await supabase.from('posts').select('slug').like('slug', `${base}%`);
        if (error) return base;

        const used = new Set((data ?? []).map((post) => post.slug));
        if (!used.has(base)) return base;
        let suffix = 2;
        while (used.has(`${base}-${suffix}`)) suffix += 1;
        return `${base}-${suffix}`;
      }

      function status(message) {
        const element = $('#status');
        element.textContent = message;
        element.toggleAttribute('data-on', Boolean(message));
        clearTimeout(statusTimer);
        statusTimer = setTimeout(() => element.removeAttribute('data-on'), 6000);
      }

      function showView(name) {
        const isLogin = name === 'login';
        for (const view of ['login', 'list', 'editor', 'profile']) {
          const element = $(`#view-${view}`);
          if (element) element.hidden = view !== name;
        }
        $('#admin-app').hidden = isLogin;
        if (!isLogin) {
          const [section, page] = VIEW_DETAILS[name] ?? VIEW_DETAILS.list;
          $('#admin-context-section').textContent = section;
          $('#admin-context-page').textContent = page;
          const activeNav = name === 'editor' ? 'list' : name;
          for (const navButton of document.querySelectorAll('[data-nav]')) {
            if (navButton.dataset.nav === activeNav) navButton.setAttribute('aria-current', 'page');
            else navButton.removeAttribute('aria-current');
          }
        }
        document.body.dataset.view = name;
        window.scrollTo({ top: 0 });
      }

      function accountName(user = currentUser) {
        const metadata = user?.user_metadata ?? {};
        return metadata.full_name?.trim() || metadata.name?.trim() || user?.email?.split('@')[0] || 'Equipe';
      }

      function accountInitials(name) {
        return name
          .split(/\s+/)
          .filter(Boolean)
          .slice(0, 2)
          .map((part) => part[0])
          .join('')
          .toUpperCase() || 'AR';
      }

      function updateUserPresentation(user = currentUser) {
        if (!user) return;
        const name = accountName(user);
        const firstName = name.split(/\s+/)[0] || 'equipe';
        const initials = accountInitials(name);
        const avatarUrl = user.user_metadata?.avatar_url;

        document.querySelectorAll('[data-user-name]').forEach((element) => {
          element.textContent = name;
        });
        document.querySelectorAll('[data-user-first-name]').forEach((element) => {
          element.textContent = firstName;
        });
        document.querySelectorAll('[data-user-initial]').forEach((element) => {
          element.textContent = initials;
          element.hidden = Boolean(avatarUrl);
        });
        document.querySelectorAll('[data-user-avatar]').forEach((image) => {
          if (avatarUrl) {
            image.src = avatarUrl;
            image.hidden = false;
          } else {
            image.removeAttribute('src');
            image.hidden = true;
          }
        });
      }

      async function hydrateUser() {
        if (!supabase) return null;
        const { data, error } = await supabase.auth.getUser();
        if (error || !data?.user) return null;
        currentUser = data.user;
        $('#profile-name').value = accountName(currentUser);
        $('#profile-email').value = currentUser.email ?? '';
        updateUserPresentation();
        return currentUser;
      }

      function setProfileMessage(selector, message, error = false) {
        const element = $(selector);
        element.textContent = message;
        element.toggleAttribute('data-error', error);
      }

      function activeLang() {
        return document.querySelector('.admin-tab[aria-selected="true"]')?.dataset.lang ?? 'pt';
      }

      function showPanel(lang) {
        for (const other of LANGS) {
          $(`#panel-${other}`).hidden = other !== lang;
          $(`#tab-${other}`).setAttribute('aria-selected', String(other === lang));
        }
      }

      // ---------------------------------------------------------------- Login

      function setLoginMode(mode = 'login') {
        const isRecovery = mode === 'recovery';
        $('#login-form').hidden = isRecovery;
        $('#reset-password-form').hidden = !isRecovery;
        $('#login-title').innerHTML = isRecovery ? 'Defina uma <span>nova senha.</span>' : 'Acesse o <span>painel.</span>';
        $('#login-description').textContent = isRecovery
          ? 'Escolha uma senha nova para voltar a acessar o painel do blog.'
          : 'Entre com suas credenciais para administrar as publicações do blog.';
        if (isRecovery) {
          $('#reset-password').focus();
        }
      }

      $('#password-toggle').addEventListener('click', () => {
        const input = $('#login-password');
        const isVisible = input.type === 'text';
        input.type = isVisible ? 'password' : 'text';
        $('#password-toggle').setAttribute('aria-pressed', String(!isVisible));
        $('#password-toggle').setAttribute('aria-label', isVisible ? 'Mostrar senha' : 'Ocultar senha');
        $('[data-password-eye="show"]').hidden = !isVisible;
        $('[data-password-eye="hide"]').hidden = isVisible;
      });

      $('#forgot-password').addEventListener('click', async () => {
        const emailInput = $('#login-email');
        const email = emailInput.value.trim();
        const button = $('#forgot-password');
        const message = $('#login-message');

        $('#login-error').textContent = '';
        message.textContent = '';
        if (!email || !emailInput.checkValidity()) {
          $('#login-error').textContent = 'Informe um e-mail válido para recuperar a senha.';
          emailInput.focus();
          emailInput.reportValidity();
          return;
        }
        if (!configured) return;

        const label = button.textContent;
        button.disabled = true;
        button.textContent = 'Enviando…';
        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: new URL('/admin', window.location.origin).href,
        });
        button.disabled = false;
        button.textContent = label;

        if (error) {
          $('#login-error').textContent = 'Não foi possível enviar o e-mail de recuperação. Tente novamente.';
          return;
        }
        message.textContent = 'Se o e-mail estiver cadastrado, você receberá as instruções para redefinir sua senha.';
      });

      $('#reset-password-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const password = $('#reset-password').value;
        const confirmation = $('#reset-password-confirmation').value;
        const errorMessage = $('#reset-error');
        const message = $('#reset-message');
        errorMessage.textContent = '';
        message.textContent = '';

        if (password !== confirmation) {
          errorMessage.textContent = 'As senhas precisam ser iguais.';
          $('#reset-password-confirmation').focus();
          return;
        }
        if (!configured) return;

        const button = event.target.querySelector('button[type="submit"]');
        button.disabled = true;
        const { error } = await supabase.auth.updateUser({ password });
        button.disabled = false;
        if (error) {
          errorMessage.textContent = 'Não foi possível atualizar a senha. Peça um novo link e tente novamente.';
          return;
        }

        event.target.reset();
        await supabase.auth.signOut();
        setLoginMode();
        $('#login-message').textContent = 'Senha atualizada. Entre usando sua nova senha.';
      });

      $('#reset-cancel').addEventListener('click', async () => {
        await supabase?.auth.signOut();
        setLoginMode();
      });

      const sidebarCollapse = $('#sidebar-collapse');
      const setSidebarCollapsed = (collapsed) => {
        $('#admin-app').toggleAttribute('data-collapsed', collapsed);
        sidebarCollapse.setAttribute('aria-expanded', String(!collapsed));
        sidebarCollapse.setAttribute('aria-label', collapsed ? 'Expandir menu' : 'Minimizar menu');
        localStorage.setItem('admin-sidebar-collapsed', collapsed ? '1' : '0');
      };
      setSidebarCollapsed(localStorage.getItem('admin-sidebar-collapsed') === '1');
      sidebarCollapse.addEventListener('click', () => {
        setSidebarCollapsed(!$('#admin-app').hasAttribute('data-collapsed'));
      });

      $('#login-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!configured) return;
        $('#login-error').textContent = '';
        $('#login-message').textContent = '';
        const button = event.target.querySelector('button[type="submit"]');
        button.disabled = true;
        const { error } = await supabase.auth.signInWithPassword({
          email: $('#login-email').value.trim(),
          password: $('#login-password').value,
        });
        button.disabled = false;
        if (error) {
          $('#login-error').textContent = 'Não foi possível entrar. Confira o e-mail e a senha.';
          return;
        }
        $('#login-error').textContent = '';
        await enterList();
      });

      $('#logout').addEventListener('click', async () => {
        await supabase?.auth.signOut();
        editing = null;
        currentUser = null;
        showView('login');
      });

      // --------------------------------------------------- Navegação e perfil

      async function openProfile() {
        await hydrateUser();
        setProfileMessage('#profile-message', '');
        setProfileMessage('#profile-password-message', '');
        showView('profile');
      }

      for (const button of document.querySelectorAll('[data-nav]')) {
        button.addEventListener('click', async () => {
          const destination = button.dataset.nav;
          if (destination === 'list') await enterList();
          if (destination === 'profile') await openProfile();
        });
      }

      $('#profile-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!currentUser || !supabase) return;

        const name = $('#profile-name').value.trim();
        const email = $('#profile-email').value.trim();
        if (!name) {
          setProfileMessage('#profile-message', 'Informe o nome que deve aparecer no painel.', true);
          $('#profile-name').focus();
          return;
        }
        if (!email || !$('#profile-email').checkValidity()) {
          setProfileMessage('#profile-message', 'Informe um e-mail válido.', true);
          $('#profile-email').focus();
          return;
        }

        const button = event.target.querySelector('button[type="submit"]');
        const emailChanged = email !== currentUser.email;
        button.disabled = true;
        setProfileMessage('#profile-message', 'Salvando seus dados…');
        const { data, error } = await supabase.auth.updateUser({
          ...(emailChanged ? { email } : {}),
          data: { ...(currentUser.user_metadata ?? {}), full_name: name },
        });
        button.disabled = false;
        if (error) {
          setProfileMessage('#profile-message', 'Não foi possível salvar os dados. Tente novamente.', true);
          return;
        }
        currentUser = data.user ?? currentUser;
        updateUserPresentation();
        setProfileMessage(
          '#profile-message',
          emailChanged
            ? 'Dados salvos. Confirme o novo e-mail pelo link enviado para sua caixa de entrada.'
            : 'Dados atualizados com sucesso.',
        );
      });

      $('#profile-password-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!supabase) return;
        const password = $('#profile-password').value;
        const confirmation = $('#profile-password-confirmation').value;
        if (password !== confirmation) {
          setProfileMessage('#profile-password-message', 'As senhas precisam ser iguais.', true);
          $('#profile-password-confirmation').focus();
          return;
        }

        const button = event.target.querySelector('button[type="submit"]');
        button.disabled = true;
        setProfileMessage('#profile-password-message', 'Atualizando senha…');
        const { error } = await supabase.auth.updateUser({ password });
        button.disabled = false;
        if (error) {
          setProfileMessage('#profile-password-message', 'Não foi possível atualizar a senha. Tente novamente.', true);
          return;
        }
        event.target.reset();
        setProfileMessage('#profile-password-message', 'Senha atualizada. Use-a no seu próximo acesso.');
      });

      $('#profile-avatar-input').addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        event.target.value = '';
        if (!file || !currentUser || !supabase) return;
        if (!file.type.startsWith('image/')) {
          setProfileMessage('#profile-message', 'Escolha uma imagem em JPG, PNG ou WebP.', true);
          return;
        }

        const extension = file.type === 'image/png' ? 'png' : file.type === 'image/webp' ? 'webp' : 'jpg';
        const path = `avatars/${currentUser.id}/${Date.now()}.${extension}`;
        setProfileMessage('#profile-message', 'Enviando sua nova foto…');
        const { error: uploadError } = await supabase.storage.from('blog').upload(path, file, {
          contentType: file.type,
          upsert: false,
        });
        if (uploadError) {
          setProfileMessage('#profile-message', 'Não foi possível enviar a foto. Tente novamente.', true);
          return;
        }

        const { data: publicUrl } = supabase.storage.from('blog').getPublicUrl(path);
        const { data, error } = await supabase.auth.updateUser({
          data: { ...(currentUser.user_metadata ?? {}), avatar_url: publicUrl.publicUrl },
        });
        if (error) {
          setProfileMessage('#profile-message', 'A imagem foi enviada, mas não pôde ser vinculada ao seu perfil.', true);
          return;
        }
        currentUser = data.user ?? currentUser;
        updateUserPresentation();
        setProfileMessage('#profile-message', 'Foto de perfil atualizada.');
      });

      // ----------------------------------------------------------- Categorias

      // { slug, name_pt, name_es, name_en }. O slug nunca muda e é o que fica em posts.category;
      // renomear só troca os nomes mostrados. Apagar solta os posts da categoria (FK set null).
      let categories = [];
      let dialogCategory = null; // categoria aberta no diálogo; null quando é uma nova

      const ICON_EDIT =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>';
      const ICON_TRASH =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>';

      const categoryDialog = $('#category-dialog');

      const sortCategories = () => categories.sort((a, b) => a.name_pt.localeCompare(b.name_pt, 'pt-BR'));
      const categoryDisplayName = (slug) => categories.find((category) => category.slug === slug)?.name_pt ?? slug;

      function setCategoryMenu(open) {
        $('#category-menu').hidden = !open;
        $('#category-button').setAttribute('aria-expanded', String(open));
      }

      function categoryIconButton(icon, label, handler, danger = false) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'admin-combo-icon';
        if (danger) button.dataset.danger = '';
        button.setAttribute('aria-label', label);
        button.title = label;
        button.innerHTML = icon;
        button.addEventListener('click', handler);
        return button;
      }

      function categoryRow(label, slug, actions = []) {
        const pick = document.createElement('button');
        pick.type = 'button';
        pick.className = 'admin-combo-pick';
        pick.textContent = label;
        if ((editing?.category ?? '') === slug) pick.setAttribute('aria-current', 'true');
        pick.addEventListener('click', () => {
          editing.category = slug;
          updateCategoryButton();
          setCategoryMenu(false);
          $('#category-button').focus();
        });
        const row = document.createElement('li');
        row.className = 'admin-combo-row';
        row.append(pick, ...actions);
        return row;
      }

      // Atualiza o rótulo do botão e a lista aberta com a categoria do post em edição.
      function updateCategoryButton() {
        $('#category-current').textContent = editing?.category ? categoryDisplayName(editing.category) : 'Sem categoria';
        const rows = [categoryRow('Sem categoria', '')];
        for (const category of categories) {
          rows.push(
            categoryRow(category.name_pt, category.slug, [
              categoryIconButton(ICON_EDIT, `Editar a categoria ${category.name_pt}`, () => openCategoryDialog(category)),
              categoryIconButton(ICON_TRASH, `Excluir a categoria ${category.name_pt}`, () => deleteCategory(category), true),
            ]),
          );
        }
        $('#category-options').replaceChildren(...rows);
      }

      function updatePublishToggle() {
        const published = editing?.status === 'published';
        const button = $('#btn-unpublish');
        button.disabled = !published;
        button.setAttribute('aria-pressed', String(published));
        $('#publish-title').textContent = published ? 'Publicado no site' : 'Rascunho';
        const since = editing?.publishedAt
          ? ` Desde ${new Date(editing.publishedAt).toLocaleDateString('pt-BR')}.`
          : '';
        $('#publish-description').textContent = published
          ? `Visível no blog.${since} Desligue para voltar a rascunho.`
          : 'Ainda não aparece no site. Para publicar, use o botão no fim da página.';
      }

      function updateFeaturedToggle() {
        const enabled = Boolean(editing?.isFeatured);
        $('#featured-toggle').setAttribute('aria-pressed', String(enabled));
        $('#featured-title').textContent = enabled ? 'Exibir entre os destaques da home' : 'Mostrar na página inicial';
      }

      function updatePrimaryToggle() {
        const enabled = Boolean(editing?.isPrimary);
        $('#primary-toggle').setAttribute('aria-pressed', String(enabled));
        $('#primary-title').textContent = enabled ? 'Postagem principal do blog' : 'Usar como postagem principal';
        $('#primary-description').textContent = editing?.status === 'published'
          ? 'Substitui a postagem principal atual da listagem.'
          : 'Ao publicar, ocupa o maior espaço na listagem do blog.';
      }

      async function loadCategories() {
        const { data, error } = await supabase.from('categories').select('slug,name_pt,name_es,name_en');
        if (error) {
          status(`Não foi possível carregar as categorias: ${error.message}`);
          return;
        }
        categories = data ?? [];
        sortCategories();
        updateCategoryButton();
      }

      function categorySlugFor(name) {
        const base = slugify(name) || 'categoria';
        const used = new Set(categories.map((category) => category.slug));
        let slug = base;
        let suffix = 2;
        while (used.has(slug)) slug = `${base}-${suffix++}`;
        return slug;
      }

      function openCategoryDialog(category = null) {
        dialogCategory = category;
        $('#category-dialog-title').textContent = category ? 'Editar categoria' : 'Nova categoria';
        $('#category-name-pt').value = category?.name_pt ?? '';
        // Nome igual ao português é só o padrão de "em branco"; mostra vazio para ficar claro.
        $('#category-name-es').value = category && category.name_es !== category.name_pt ? category.name_es : '';
        $('#category-name-en').value = category && category.name_en !== category.name_pt ? category.name_en : '';
        $('#category-dialog-message').textContent = '';
        setCategoryMenu(false);
        categoryDialog.showModal();
        $('#category-name-pt').focus();
      }

      async function deleteCategory(category) {
        setCategoryMenu(false);
        const { count } = await supabase
          .from('posts')
          .select('id', { count: 'exact', head: true })
          .eq('category', category.slug);
        const effect = !count
          ? ''
          : count === 1
            ? ' A publicação que usa essa categoria fica sem categoria.'
            : ` As ${count} publicações que usam essa categoria ficam sem categoria.`;
        if (!confirm(`Excluir a categoria “${category.name_pt}”?${effect}`)) return;

        const { data, error } = await supabase.from('categories').delete().eq('slug', category.slug).select('slug');
        if (error || !data?.length) {
          status(`Não foi possível excluir a categoria${error ? `: ${error.message}` : '.'}`);
          return;
        }
        categories = categories.filter((item) => item.slug !== category.slug);
        if (editing?.category === category.slug) editing.category = '';
        updateCategoryButton();
        status('Categoria excluída.');
      }

      $('#category-button').addEventListener('click', () => setCategoryMenu($('#category-menu').hidden));
      $('#category-add').addEventListener('click', () => openCategoryDialog());
      $('#category-cancel').addEventListener('click', () => categoryDialog.close());
      $('#featured-toggle').addEventListener('click', () => {
        editing.isFeatured = !editing.isFeatured;
        updateFeaturedToggle();
        status(editing.isFeatured ? 'Esta publicação aparecerá entre os destaques ao ser publicada.' : 'Esta publicação saiu dos destaques da página inicial.');
      });
      $('#primary-toggle').addEventListener('click', () => {
        editing.isPrimary = !editing.isPrimary;
        updatePrimaryToggle();
        status(editing.isPrimary
          ? 'Esta publicação será a postagem principal do blog quando estiver publicada.'
          : 'Esta publicação não será mais a postagem principal do blog.');
      });
      // Clique no fundo escurecido fecha o diálogo (o formulário ocupa o resto da caixa).
      categoryDialog.addEventListener('click', (event) => {
        if (event.target === categoryDialog) categoryDialog.close();
      });
      document.addEventListener('click', (event) => {
        if (!event.composedPath().includes($('#category-combo'))) setCategoryMenu(false);
      });
      $('#category-combo').addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !$('#category-menu').hidden) {
          event.stopPropagation();
          setCategoryMenu(false);
          $('#category-button').focus();
        }
      });

      $('#category-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const message = $('#category-dialog-message');
        const namePt = $('#category-name-pt').value.trim();
        if (!namePt) {
          message.textContent = 'Informe o nome em português.';
          $('#category-name-pt').focus();
          return;
        }
        const duplicate = categories.some(
          (category) => category.slug !== dialogCategory?.slug && category.name_pt.toLowerCase() === namePt.toLowerCase(),
        );
        if (duplicate) {
          message.textContent = 'Já existe uma categoria com esse nome.';
          return;
        }

        const names = {
          name_pt: namePt,
          name_es: $('#category-name-es').value.trim() || namePt,
          name_en: $('#category-name-en').value.trim() || namePt,
        };
        const isEdit = Boolean(dialogCategory);
        const saveButton = $('#category-save');
        saveButton.disabled = true;
        message.textContent = '';
        const { data, error } = await (isEdit
          ? supabase.from('categories').update(names).eq('slug', dialogCategory.slug).select().single()
          : supabase.from('categories').insert({ slug: categorySlugFor(namePt), ...names }).select().single());
        saveButton.disabled = false;
        if (error) {
          message.textContent = `Não foi possível salvar: ${error.message}`;
          return;
        }

        if (isEdit) {
          categories = categories.map((category) => (category.slug === data.slug ? data : category));
        } else {
          categories.push(data);
          if (editing) editing.category = data.slug;
        }
        sortCategories();
        updateCategoryButton();
        categoryDialog.close();
        status(isEdit ? 'Categoria atualizada.' : 'Categoria criada e escolhida para este post.');
      });

      // ------------------------------------------------------------- Listagem

      async function enterList() {
        await hydrateUser();
        await checkAdminHint();
        await loadCategories();
        await renderList();
        showView('list');
      }

      async function checkAdminHint() {
        if (!supabase) return;
        const { data } = await supabase.from('admins').select('email').limit(1);
        $('#admin-hint').hidden = Boolean(data?.length);
      }

      async function renderList() {
        const list = $('#post-list');
        list.replaceChildren();
        const { data, error } = await supabase
          .from('posts')
          .select('id,slug,status,is_featured,is_primary,source_lang,published_at,post_translations(lang,title,manually_edited)')
          .order('updated_at', { ascending: false });
        if (error) {
          status(`Não foi possível carregar os posts: ${error.message}`);
          return;
        }
        if (!data?.length) {
          const empty = document.createElement('li');
          empty.className = 'admin-empty';
          empty.textContent = 'Nenhuma publicação ainda. Comece com “Nova publicação”.';
          list.append(empty);
          return;
        }
        for (const post of data) {
          const translations = Object.fromEntries((post.post_translations ?? []).map((t) => [t.lang, t]));
          const title = translations[post.source_lang]?.title ?? post.slug;

          const titleElement = document.createElement('p');
          titleElement.className = 'admin-post-title';
          titleElement.textContent = title;

          const badge = document.createElement('span');
          badge.className = 'admin-badge';
          badge.dataset.status = post.status;
          badge.textContent = post.status === 'published' ? 'Publicado' : 'Rascunho';

          const meta = document.createElement('p');
          meta.className = 'admin-post-meta';
          meta.append(badge);
          if (post.is_featured) {
            const featuredBadge = document.createElement('span');
            featuredBadge.className = 'admin-badge admin-featured-badge';
            featuredBadge.textContent = 'Destaque';
            meta.append(featuredBadge);
          }
          if (post.is_primary) {
            const primaryBadge = document.createElement('span');
            primaryBadge.className = 'admin-badge admin-primary-badge';
            primaryBadge.textContent = post.status === 'published' ? 'Principal do blog' : 'Principal ao publicar';
            meta.append(primaryBadge);
          }
          meta.append(document.createTextNode(`/${post.slug}`));
          if (post.published_at) meta.append(document.createTextNode(new Date(post.published_at).toLocaleDateString('pt-BR')));

          const editButton = document.createElement('button');
          editButton.className = 'button button-outline';
          editButton.type = 'button';
          editButton.textContent = 'Editar';
          editButton.addEventListener('click', () => openEditor(post.id));

          const deleteButton = document.createElement('button');
          deleteButton.className = 'button button-light';
          deleteButton.type = 'button';
          deleteButton.textContent = 'Apagar';
          deleteButton.addEventListener('click', () => deletePost(post.id, title));

          const actions = document.createElement('div');
          actions.className = 'admin-post-actions';
          actions.append(editButton, deleteButton);

          const item = document.createElement('li');
          item.className = 'admin-post';
          item.append(titleElement, meta, actions);
          list.append(item);
        }
      }

      async function deletePost(id, title) {
        if (!confirm(`Apagar “${title}”? As três versões e as imagens ligadas ao texto somem junto.`)) return;
        const { error } = await supabase.from('posts').delete().eq('id', id);
        if (error) {
          status(`Não foi possível apagar: ${error.message}`);
          return;
        }
        await renderList();
      }

      // --------------------------------------------------------------- Editor

      function startNewPost() {
        editing = { id: null, slug: '', sourceLang: 'pt', status: 'draft', publishedAt: null, coverImage: null, category: '', author: '', isFeatured: false, isPrimary: false, translations: { pt: null, es: null, en: null } };
        fillEditor();
        showView('editor');
      }

      $('#new-post').addEventListener('click', startNewPost);
      for (const button of document.querySelectorAll('[data-new-post]')) {
        button.addEventListener('click', startNewPost);
      }

      $('#btn-back').addEventListener('click', async () => {
        await enterList();
      });

      async function openEditor(id) {
        const { data, error } = await supabase.from('posts').select('*,post_translations(*)').eq('id', id).single();
        if (error || !data) {
          status('Não foi possível abrir o post.');
          return;
        }
        editing = {
          id: data.id,
          slug: data.slug,
          sourceLang: data.source_lang,
          status: data.status,
          publishedAt: data.published_at,
          coverImage: data.cover_image,
          category: data.category ?? '',
          author: data.author ?? '',
          isFeatured: Boolean(data.is_featured),
          isPrimary: Boolean(data.is_primary),
          translations: { pt: null, es: null, en: null },
        };
        for (const translation of data.post_translations ?? []) editing.translations[translation.lang] = translation;
        fillEditor();
        showView('editor');
      }

      function fillEditor() {
        $('#editor-title').textContent = editing.id ? 'Ajuste sua publicação.' : 'Escreva uma publicação.';
        $('#source-lang').value = editing.sourceLang;
        $('#slug').value = editing.slug;
        setCategoryMenu(false);
        updateCategoryButton();
        $('#author').value = editing.author;
        updateFeaturedToggle();
        updatePrimaryToggle();
        updatePublishToggle();

        setCoverPreview(editing.coverImage);

        $('#btn-publish').hidden = editing.status === 'published';
        $('#btn-retranslate').hidden = editing.status !== 'published';
        $('#btn-save-draft').textContent = editing.status === 'published' ? 'Salvar alterações' : 'Salvar rascunho';

        renderTabs();
        showPanel(editing.sourceLang);
        fillPanel(editing.sourceLang);
      }

      function renderTabs() {
        for (const lang of LANGS) {
          const translation = editing.translations[lang];
          const badge = $(`#tab-${lang} .admin-tab-badge`);
          let label;
          let state = '';
          if (lang === editing.sourceLang) {
            label = 'original';
            state = 'original';
          } else if (!translation) {
            label = 'sem tradução';
          } else if (translation.manually_edited) {
            label = 'editada à mão';
            state = 'manual';
          } else {
            label = 'automática';
          }
          badge.textContent = label;
          if (state) badge.dataset.state = state;
          else delete badge.dataset.state;
        }
      }

      function dragHasFiles(event) {
        return [...(event.dataTransfer?.types ?? [])].includes('Files');
      }

      function splitComposerMarkdown(markdown) {
        const parts = [];
        const source = markdown ?? '';
        const pattern = /!\[([^\]]*)\]\(([^)\s]+)\)/g;
        let last = 0;
        let match = pattern.exec(source);
        while (match) {
          if (match.index > last) parts.push({ type: 'text', text: source.slice(last, match.index) });
          parts.push({ type: 'image', alt: match[1] || 'imagem', url: match[2] });
          last = match.index + match[0].length;
          match = pattern.exec(source);
        }
        if (last < source.length) parts.push({ type: 'text', text: source.slice(last) });
        return parts;
      }

      function composerImage(url, alt = 'imagem') {
        const image = document.createElement('img');
        image.src = url;
        image.alt = alt || 'imagem';
        image.dataset.composerImage = 'true';
        image.dataset.src = url;
        image.draggable = false;
        return image;
      }

      function composerParagraph(text) {
        const paragraph = document.createElement('p');
        const lines = text.split('\n');
        lines.forEach((line, index) => {
          if (index) paragraph.append(document.createElement('br'));
          paragraph.append(document.createTextNode(line));
        });
        if (!paragraph.childNodes.length) paragraph.append(document.createElement('br'));
        return paragraph;
      }

      function appendInline(parent, text) {
        const pattern = /(\*\*([^*]+)\*\*|\[([^\]\n]+)\]\((https?:\/\/[^)\s]+|mailto:[^)\s]+)\))/g;
        let last = 0;
        let match = pattern.exec(text);
        while (match) {
          if (match.index > last) parent.append(document.createTextNode(text.slice(last, match.index)));
          if (match[2] != null) {
            const strong = document.createElement('strong');
            appendInline(strong, match[2]);
            parent.append(strong);
          } else {
            const link = document.createElement('a');
            link.href = match[4];
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            appendInline(link, match[3]);
            parent.append(link);
          }
          last = match.index + match[0].length;
          match = pattern.exec(text);
        }
        if (last < text.length) parent.append(document.createTextNode(text.slice(last)));
      }

      function appendComposerText(surface, text) {
        const lines = text.replace(/^\n+/, '').replace(/\n+$/, '').split('\n');
        let index = 0;
        while (index < lines.length) {
          const line = lines[index];
          if (!line.trim()) {
            index += 1;
            continue;
          }
          const heading = /^(#{2,3})\s+(.+)$/.exec(line);
          if (heading) {
            const element = document.createElement(heading[1].length === 2 ? 'h2' : 'h3');
            appendInline(element, heading[2]);
            surface.append(element);
            index += 1;
            continue;
          }
          if (/^[-*]\s+/.test(line)) {
            const list = document.createElement('ul');
            while (index < lines.length && /^[-*]\s+/.test(lines[index])) {
              const item = document.createElement('li');
              appendInline(item, lines[index].replace(/^[-*]\s+/, ''));
              list.append(item);
              index += 1;
            }
            surface.append(list);
            continue;
          }
          const paragraph = document.createElement('p');
          let first = true;
          while (index < lines.length && lines[index].trim() && !/^(#{2,3})\s+/.test(lines[index]) && !/^[-*]\s+/.test(lines[index])) {
            if (!first) paragraph.append(document.createElement('br'));
            appendInline(paragraph, lines[index]);
            first = false;
            index += 1;
          }
          surface.append(paragraph);
        }
      }

      function renderComposer(panel) {
        const surface = panel.querySelector('[data-composer-surface]');
        const source = panel.querySelector('[data-field="body"]');
        if (!surface || !source) return;
        surface.replaceChildren();
        const parts = splitComposerMarkdown(source.value);
        if (!parts.length) {
          surface.append(composerParagraph(''));
        } else {
          for (const part of parts) {
            if (part.type === 'image') surface.append(composerImage(part.url, part.alt));
            else appendComposerText(surface, part.text);
          }
          if (!surface.childNodes.length) surface.append(composerParagraph(''));
        }
        updateComposerEmpty(panel);
      }

      function inlineMarkdown(node) {
        let text = '';
        for (const child of node.childNodes) {
          if (child.nodeType === Node.TEXT_NODE) {
            text += child.textContent.replace(/\u00a0/g, ' ');
            continue;
          }
          if (child.nodeType !== Node.ELEMENT_NODE) continue;
          if (child.nodeName === 'BR') {
            text += '\n';
            continue;
          }
          const inner = inlineMarkdown(child);
          if (child.nodeName === 'STRONG' || child.nodeName === 'B') text += inner ? `**${inner}**` : '';
          else if (child.nodeName === 'A') {
            const href = child.getAttribute('href') || '';
            text += href ? `[${inner || href}](${href})` : inner;
          } else text += inner;
        }
        return text;
      }

      function serializeComposer(surface) {
        const blocks = [];
        const addBlock = (node) => {
          if (node.nodeType === Node.TEXT_NODE) {
            const text = node.textContent.replace(/\u00a0/g, ' ').trim();
            if (text) blocks.push(text);
            return;
          }
          if (node.nodeType !== Node.ELEMENT_NODE) return;
          if (node.dataset?.composerImage) {
            const url = node.dataset.src || node.getAttribute('src');
            if (url) blocks.push(`![${node.alt || 'imagem'}](${url})`);
            return;
          }
          const name = node.nodeName;
          if (name === 'UL' || name === 'OL') {
            const items = [...node.children]
              .filter((item) => item.nodeName === 'LI')
              .map((item) => inlineMarkdown(item).trim())
              .filter(Boolean)
              .map((item) => `- ${item}`);
            if (items.length) blocks.push(items.join('\n'));
            return;
          }
          if (name === 'DIV' && [...node.children].some((child) => /^(P|H2|H3|UL|OL|DIV)$/.test(child.nodeName))) {
            for (const child of node.childNodes) addBlock(child);
            return;
          }
          const text = inlineMarkdown(node).trim();
          if (!text) return;
          if (name === 'H2') blocks.push(`## ${text}`);
          else if (name === 'H3') blocks.push(`### ${text}`);
          else blocks.push(text);
        };
        for (const child of surface.childNodes) addBlock(child);
        return blocks.join('\n\n').trim();
      }

      function syncComposer(panel) {
        const surface = panel.querySelector('[data-composer-surface]');
        const source = panel.querySelector('[data-field="body"]');
        if (!surface || !source) return;
        source.value = serializeComposer(surface);
      }

      function updateComposerEmpty(panel) {
        const stage = panel.querySelector('[data-composer-stage]');
        const surface = panel.querySelector('[data-composer-surface]');
        if (!stage || !surface) return;
        const empty = !serializeComposer(surface);
        if (empty) stage.dataset.empty = 'true';
        else delete stage.dataset.empty;
      }

      function composerSelection(surface) {
        const selection = document.getSelection();
        if (!selection.rangeCount || !surface.contains(selection.anchorNode)) {
          const end = document.createRange();
          end.selectNodeContents(surface);
          end.collapse(false);
          selection.removeAllRanges();
          selection.addRange(end);
        }
        return selection;
      }

      function composerBlock(node, surface) {
        let current = node?.nodeType === Node.ELEMENT_NODE ? node : node?.parentElement;
        while (current && current !== surface) {
          if (current.nodeName === 'LI') return current;
          if (current.parentElement === surface) return current;
          current = current.parentElement;
        }
        return null;
      }

      function placeComposerCaret(element) {
        const selection = document.getSelection();
        const range = document.createRange();
        range.selectNodeContents(element);
        range.collapse(false);
        selection.removeAllRanges();
        selection.addRange(range);
      }

      function moveChildren(from, to) {
        while (from.firstChild) to.append(from.firstChild);
        if (!to.childNodes.length) to.append(document.createElement('br'));
      }

      function safeLinkHref(value) {
        const href = value.trim();
        if (/^https?:\/\//i.test(href) || /^mailto:/i.test(href)) return href;
        if (/^[\w.-]+\.[a-z]{2,}([/?#].*)?$/i.test(href)) return `https://${href}`;
        return '';
      }

      function applyComposerBlock(surface, tagName) {
        const selection = composerSelection(surface);
        let block = composerBlock(selection.anchorNode, surface);
        if (block?.nodeName === 'LI') {
          const list = block.parentElement;
          const heading = document.createElement(tagName);
          moveChildren(block, heading);
          if (list.children.length === 1) list.replaceWith(heading);
          else {
            block.remove();
            list.after(heading);
          }
          placeComposerCaret(heading);
          return;
        }
        if (!block || block === surface) {
          const heading = document.createElement(tagName);
          heading.append(document.createElement('br'));
          surface.append(heading);
          placeComposerCaret(heading);
          return;
        }
        const nextTag = block.nodeName === tagName.toUpperCase() ? 'p' : tagName;
        const replacement = document.createElement(nextTag);
        moveChildren(block, replacement);
        block.replaceWith(replacement);
        placeComposerCaret(replacement);
      }

      function applyComposerBold(surface) {
        const selection = composerSelection(surface);
        const range = selection.getRangeAt(0);
        const existing = (range.startContainer.nodeType === Node.ELEMENT_NODE ? range.startContainer : range.startContainer.parentElement)?.closest('strong, b');
        if (existing && surface.contains(existing)) {
          const parent = existing.parentNode;
          while (existing.firstChild) parent.insertBefore(existing.firstChild, existing);
          existing.remove();
          return;
        }
        const strong = document.createElement('strong');
        if (range.collapsed) {
          strong.textContent = 'negrito';
          range.insertNode(strong);
        } else {
          try {
            range.surroundContents(strong);
          } catch {
            strong.append(range.extractContents());
            range.insertNode(strong);
          }
        }
        const marked = document.createRange();
        marked.selectNodeContents(strong);
        selection.removeAllRanges();
        selection.addRange(marked);
      }

      function applyComposerList(surface) {
        const selection = composerSelection(surface);
        const block = composerBlock(selection.anchorNode, surface);
        if (block?.nodeName === 'LI') {
          const list = block.parentElement;
          const paragraphs = [...list.children].map((item) => {
            const paragraph = document.createElement('p');
            moveChildren(item, paragraph);
            return paragraph;
          });
          list.replaceWith(...paragraphs);
          placeComposerCaret(paragraphs[0]);
          return;
        }
        const item = document.createElement('li');
        if (block && block !== surface && /^(P|H2|H3|DIV)$/.test(block.nodeName)) moveChildren(block, item);
        else item.textContent = 'item da lista';
        const list = document.createElement('ul');
        list.append(item);
        if (block && block !== surface && /^(P|H2|H3|DIV)$/.test(block.nodeName)) block.replaceWith(list);
        else surface.append(list);
        placeComposerCaret(item);
      }

      function applyComposerLink(surface) {
        const typed = window.prompt('Endereço do link', 'https://');
        if (!typed) return;
        const href = safeLinkHref(typed);
        if (!href) {
          status('Use um endereço http, https ou e-mail.');
          return;
        }
        const selection = composerSelection(surface);
        const range = selection.getRangeAt(0);
        const current = (range.startContainer.nodeType === Node.ELEMENT_NODE ? range.startContainer : range.startContainer.parentElement)?.closest('a');
        if (current && surface.contains(current)) {
          current.href = href;
          return;
        }
        const link = document.createElement('a');
        link.href = href;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        if (range.collapsed) {
          link.textContent = 'texto do link';
          range.insertNode(link);
        } else {
          try {
            range.surroundContents(link);
          } catch {
            link.append(range.extractContents());
            range.insertNode(link);
          }
        }
        const marked = document.createRange();
        marked.selectNodeContents(link);
        selection.removeAllRanges();
        selection.addRange(marked);
      }

      function insertComposerMarkup(panel, kind) {
        const surface = panel.querySelector('[data-composer-surface]');
        surface.focus();
        if (kind === 'h2') applyComposerBlock(surface, 'h2');
        else if (kind === 'h3') applyComposerBlock(surface, 'h3');
        else if (kind === 'bold') applyComposerBold(surface);
        else if (kind === 'list') applyComposerList(surface);
        else if (kind === 'link') applyComposerLink(surface);
        syncComposer(panel);
        updateComposerEmpty(panel);
      }

      function insertComposerImage(panel, url) {
        const surface = panel.querySelector('[data-composer-surface]');
        const image = composerImage(url);
        const after = composerParagraph('');
        const selection = document.getSelection();
        const inside = selection?.rangeCount && surface.contains(selection.anchorNode);
        if (inside) {
          const range = selection.getRangeAt(0);
          range.deleteContents();
          const fragment = document.createDocumentFragment();
          fragment.append(image, after);
          range.insertNode(fragment);
          const caret = document.createRange();
          caret.setStart(after, 0);
          caret.collapse(true);
          selection.removeAllRanges();
          selection.addRange(caret);
        } else {
          if (!serializeComposer(surface)) surface.replaceChildren();
          surface.append(image, after);
        }
        syncComposer(panel);
        updateComposerEmpty(panel);
      }

      function trackUploadProgress(file, onProgress) {
        let current = 0;
        let finished = false;
        const sizeKb = Math.max(50, file?.size ? file.size / 1024 : 100);
        const duration = Math.min(2600, Math.max(750, sizeKb * 1.6));
        const startTime = Date.now();

        const timer = setInterval(() => {
          if (finished) return;
          const elapsed = Date.now() - startTime;
          const factor = 1 - Math.exp(-elapsed / (duration * 0.42));
          const target = Math.min(92, Math.round(factor * 92));
          if (target > current) {
            current = target;
            onProgress(current);
          }
        }, 32);

        return {
          finish: async () => {
            finished = true;
            clearInterval(timer);
            const startPct = Math.max(current, 93);
            for (let p = startPct; p <= 100; p += 2) {
              onProgress(p);
              await new Promise((r) => setTimeout(r, 16));
            }
            onProgress(100);
            await new Promise((r) => setTimeout(r, 220));
          },
          cancel: () => {
            finished = true;
            clearInterval(timer);
          },
        };
      }

      async function addComposerImages(panel, fileList) {
        const files = [...fileList].filter((file) => file.type.startsWith('image/'));
        if (!files.length) {
          status('Solte uma foto para inserir no texto.');
          return;
        }
        if (!editing?.id && !editing?.slug) {
          status('Escreva o título antes de enviar imagens; ele gera o endereço da publicação.');
          return;
        }
        const stage = panel.querySelector('[data-composer-stage]');
        const loading = panel.querySelector('[data-composer-loading]');
        const percentEl = loading.querySelector('[data-composer-loading-percent]');
        const barEl = loading.querySelector('[data-composer-progress-bar]');
        const titleEl = loading.querySelector('[data-composer-loading-title]');
        const subEl = loading.querySelector('[data-composer-loading-sub]');
        const iconEl = loading.querySelector('[data-composer-loading-spinner]');

        stage.dataset.loading = 'true';
        stage.setAttribute('aria-busy', 'true');
        loading.hidden = false;
        let inserted = 0;
        try {
          for (let i = 0; i < files.length; i++) {
            const file = files[i];
            const prefix = files.length > 1 ? `(${i + 1}/${files.length}) ` : '';
            percentEl.textContent = '0%';
            barEl.style.width = '0%';
            titleEl.textContent = `${prefix}Inserindo imagem no texto...`;
            subEl.textContent = file.name || 'Preparando imagem...';
            iconEl.innerHTML = '<svg class="admin-spin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="32" stroke-linecap="round"></circle></svg>';

            const tracker = trackUploadProgress(file, (pct) => {
              percentEl.textContent = `${pct}%`;
              barEl.style.width = `${pct}%`;
              if (pct < 50) {
                subEl.textContent = `${file.name || 'Imagem'} (${pct}%)`;
              } else if (pct < 90) {
                subEl.textContent = `Enviando... ${pct}%`;
              } else {
                subEl.textContent = 'Inserindo no artigo...';
              }
            });

            const url = await uploadImage(file);
            if (!url) {
              tracker.cancel();
              continue;
            }
            await tracker.finish();
            insertComposerImage(panel, url);
            inserted += 1;
          }
          if (inserted) {
            iconEl.innerHTML = '<svg class="admin-success-icon" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>';
            titleEl.textContent = inserted === 1 ? 'Imagem inserida!' : 'Imagens inseridas!';
            subEl.textContent = '100% concluído';
            await new Promise((r) => setTimeout(r, 260));
          }
        } finally {
          delete stage.dataset.loading;
          stage.removeAttribute('aria-busy');
          loading.hidden = true;
        }
        if (inserted) status(inserted === 1 ? 'Imagem inserida no texto. Salve para guardar.' : `${inserted} imagens inseridas no texto. Salve para guardar.`);
      }

      function fillPanel(lang) {
        const panel = $(`#panel-${lang}`);
        const translation = editing.translations[lang] ?? {};
        for (const field of FIELDS) panel.querySelector(`[data-field="${field}"]`).value = translation[field] ?? '';
        renderComposer(panel);
        panel.querySelector('.admin-panel-hint').textContent =
          lang === editing.sourceLang
            ? 'Este é o texto original. Ao publicar, as outras duas línguas são traduzidas na hora.'
            : editing.translations[lang]?.manually_edited
              ? 'Editada à mão: “Atualizar traduções” não mexe nesta língua.'
              : editing.translations[lang]
                ? 'Tradução automática: pode corrigir à mão; o que for corrigido deixa de ser retraduzido.'
                : 'Vai ser traduzida automaticamente ao publicar.';
      }

      for (const tab of document.querySelectorAll('.admin-tab')) {
        tab.addEventListener('click', () => showPanel(tab.dataset.lang));
      }

      // Trocar o idioma original atualiza abas e painel; as traduções antigas continuam salvas.
      $('#source-lang').addEventListener('change', (event) => {
        editing.sourceLang = event.target.value;
        renderTabs();
        showPanel(editing.sourceLang);
        fillPanel(editing.sourceLang);
        status('Idioma original alterado. Publique de novo para retraduzir as outras línguas.');
      });

      // Em um post novo, o endereço acompanha o título do texto original. Em um
      // post existente ele permanece estável, para preservar os links já divulgados.
      for (const panel of document.querySelectorAll('.admin-panel')) {
        panel.querySelector('[data-field="title"]').addEventListener('input', (event) => {
          if (!editing.id && panel.dataset.panel === editing.sourceLang) {
            setGeneratedSlug(event.target.value);
          }
        });

        const stage = panel.querySelector('[data-composer-stage]');
        const surface = panel.querySelector('[data-composer-surface]');
        const source = panel.querySelector('[data-field="body"]');
        const formatBar = panel.querySelector('.admin-md-bar');
        formatBar.addEventListener('mousedown', (event) => {
          if (event.target.closest('[data-md]')) event.preventDefault();
        });
        formatBar.addEventListener('click', (event) => {
          const button = event.target.closest('[data-md]');
          if (!button) return;
          insertComposerMarkup(panel, button.dataset.md);
        });
        surface.addEventListener('input', () => {
          syncComposer(panel);
          updateComposerEmpty(panel);
        });
        surface.addEventListener('click', (event) => {
          if (event.target.closest('a')) event.preventDefault();
        });
        source.addEventListener('input', () => renderComposer(panel));
        surface.addEventListener('paste', (event) => {
          const files = [...(event.clipboardData?.files ?? [])].filter((file) => file.type.startsWith('image/'));
          if (!files.length) return;
          event.preventDefault();
          addComposerImages(panel, files);
        });
        stage.addEventListener('dragenter', (event) => {
          if (!dragHasFiles(event)) return;
          event.preventDefault();
          stage.dataset.drag = 'true';
        });
        stage.addEventListener('dragover', (event) => {
          if (!dragHasFiles(event)) return;
          event.preventDefault();
        }, true);
        stage.addEventListener('dragleave', (event) => {
          if (stage.contains(event.relatedTarget)) return;
          delete stage.dataset.drag;
        });
        stage.addEventListener('drop', (event) => {
          event.preventDefault();
          event.stopPropagation();
          delete stage.dataset.drag;
          addComposerImages(panel, event.dataTransfer?.files ?? []);
        }, true);

        const dropzone = panel.querySelector('[data-insert-dropzone]');
        if (dropzone) {
          dropzone.addEventListener('click', (event) => {
            if (!event.target.closest('button, input, label')) {
              panel.querySelector('[data-image-input]')?.click();
            }
          });
          dropzone.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              panel.querySelector('[data-image-input]')?.click();
            }
          });
          dropzone.addEventListener('dragenter', (event) => {
            if (!dragHasFiles(event)) return;
            event.preventDefault();
            dropzone.dataset.drag = 'true';
          });
          dropzone.addEventListener('dragover', (event) => {
            if (!dragHasFiles(event)) return;
            event.preventDefault();
          }, true);
          dropzone.addEventListener('dragleave', (event) => {
            if (dropzone.contains(event.relatedTarget)) return;
            delete dropzone.dataset.drag;
          });
          dropzone.addEventListener('drop', (event) => {
            event.preventDefault();
            event.stopPropagation();
            delete dropzone.dataset.drag;
            addComposerImages(panel, event.dataTransfer?.files ?? []);
          }, true);
        }

        panel.querySelector('[data-image-input]').addEventListener('change', (event) => {
          const files = [...(event.target.files ?? [])];
          event.target.value = '';
          if (files.length) addComposerImages(panel, files);
        });
        renderComposer(panel);

        panel.querySelector('[data-save-lang]').addEventListener('click', () => saveLang(panel.dataset.panel));
      }

      // ---------------------------------------------------------------- Capa

      function setCoverPreview(url) {
        const cover = $('#cover-preview');
        const stage = $('#cover-stage');
        const selectLabel = $('#cover-select-label');
        if (url) {
          cover.src = url;
          cover.hidden = false;
          $('#cover-remove').hidden = false;
          if (selectLabel) selectLabel.textContent = 'Alterar capa';
          delete stage.dataset.empty;
        } else {
          cover.removeAttribute('src');
          cover.hidden = true;
          $('#cover-remove').hidden = true;
          if (selectLabel) selectLabel.textContent = 'Selecionar capa';
          stage.dataset.empty = 'true';
        }
      }

      async function handleCoverFile(file) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
          status('Escolha um arquivo de imagem (JPG, PNG, WebP).');
          return;
        }

        const loading = $('#cover-loading');
        const percentEl = $('#cover-loading-percent');
        const barEl = $('#cover-progress-bar');
        const titleEl = $('#cover-loading-title');
        const subEl = $('#cover-loading-sub');
        const iconEl = $('#cover-loading-icon');

        loading.hidden = false;
        percentEl.textContent = '0%';
        barEl.style.width = '0%';
        titleEl.textContent = 'Enviando imagem da capa...';
        subEl.textContent = file.name || 'Otimizando imagem...';
        iconEl.innerHTML = '<svg class="admin-spin" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="32" stroke-linecap="round"></circle></svg>';

        const tracker = trackUploadProgress(file, (pct) => {
          percentEl.textContent = `${pct}%`;
          barEl.style.width = `${pct}%`;
          if (pct < 45) {
            subEl.textContent = 'Carregando arquivo...';
          } else if (pct < 90) {
            subEl.textContent = 'Transmitindo para o servidor...';
          } else {
            subEl.textContent = 'Finalizando upload...';
          }
        });

        try {
          const url = await uploadImage(file);
          if (!url) {
            tracker.cancel();
            return;
          }
          await tracker.finish();
          titleEl.textContent = 'Capa enviada com sucesso!';
          subEl.textContent = '100% concluído';
          iconEl.innerHTML = '<svg class="admin-success-icon" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"></path></svg>';
          await new Promise((r) => setTimeout(r, 260));

          editing.coverImage = url;
          setCoverPreview(url);
          status('Capa enviada. Salve o post para guardar.');
        } catch (err) {
          tracker.cancel();
          status('Não foi possível enviar a imagem da capa.');
        } finally {
          loading.hidden = true;
        }
      }

      const coverStage = $('#cover-stage');
      coverStage?.addEventListener('click', (event) => {
        if (coverStage.dataset.empty && !event.target.closest('button, input, label')) {
          $('#cover-input').click();
        }
      });
      coverStage?.addEventListener('keydown', (event) => {
        if (coverStage.dataset.empty && (event.key === 'Enter' || event.key === ' ')) {
          event.preventDefault();
          $('#cover-input').click();
        }
      });
      coverStage?.addEventListener('dragenter', (event) => {
        if (!dragHasFiles(event)) return;
        event.preventDefault();
        coverStage.dataset.drag = 'true';
      });
      coverStage?.addEventListener('dragover', (event) => {
        if (!dragHasFiles(event)) return;
        event.preventDefault();
      }, true);
      coverStage?.addEventListener('dragleave', (event) => {
        if (coverStage.contains(event.relatedTarget)) return;
        delete coverStage.dataset.drag;
      });
      coverStage?.addEventListener('drop', (event) => {
        event.preventDefault();
        event.stopPropagation();
        delete coverStage.dataset.drag;
        const files = [...(event.dataTransfer?.files ?? [])].filter((f) => f.type.startsWith('image/'));
        if (files.length) handleCoverFile(files[0]);
      }, true);

      $('#cover-input')?.addEventListener('change', (event) => {
        const file = event.target.files?.[0];
        event.target.value = '';
        if (file) handleCoverFile(file);
      });

      $('#cover-overlay-input')?.addEventListener('change', (event) => {
        const file = event.target.files?.[0];
        event.target.value = '';
        if (file) handleCoverFile(file);
      });

      $('#cover-remove')?.addEventListener('click', () => {
        editing.coverImage = null;
        setCoverPreview(null);
      });

      $('#cover-overlay-remove')?.addEventListener('click', () => {
        editing.coverImage = null;
        setCoverPreview(null);
      });

      // -------------------------------------------------------------- Imagens

      async function uploadImage(file) {
        const extension = (file.name.split('.').pop() ?? 'jpg').toLowerCase().replace(/[^a-z0-9]/g, '');
        const month = new Date().toISOString().slice(0, 7);
        const path = `uploads/${month}/${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${extension}`;
        const { error } = await supabase.storage.from('blog').upload(path, file, { contentType: file.type, upsert: false });
        if (error) {
          status(`Não foi possível enviar a imagem: ${error.message}`);
          return null;
        }
        return `${supabaseUrl}/storage/v1/object/public/blog/${path}`;
      }

      // ---------------------------------------------------------- Salvar etc.

      function readPanel(lang) {
        const panel = $(`#panel-${lang}`);
        syncComposer(panel);
        const values = {};
        for (const field of FIELDS) values[field] = panel.querySelector(`[data-field="${field}"]`).value.trim();
        return values;
      }

      async function savePost({ publish = false, unpublish = false } = {}) {
        const original = readPanel(editing.sourceLang);
        if (!original.title) {
          status('O título no idioma original é obrigatório.');
          showPanel(editing.sourceLang);
          return null;
        }
        let slug = editing.slug || slugify(original.title);
        if (!editing.id) {
          slug = await resolveAvailableSlug(slug);
          editing.slug = slug;
          $('#slug').value = slug;
        }
        if (!slug) {
          status('Use um título com letras ou números para gerar o endereço da publicação.');
          return null;
        }

        if (publish && editing.status !== 'published') editing.publishedAt = new Date().toISOString();
        if (unpublish) {
          editing.status = 'draft';
          editing.isPrimary = false;
        }
        else if (publish) editing.status = 'published';

        // A regra do banco também impede duplicidade, mas limpar a escolha anterior
        // antes do upsert dá um retorno mais simples para quem está editando.
        if (editing.isPrimary && editing.status === 'published') {
          let clearPrimary = supabase.from('posts').update({ is_primary: false }).eq('status', 'published').eq('is_primary', true);
          if (editing.id) clearPrimary = clearPrimary.neq('id', editing.id);
          const { error: clearPrimaryError } = await clearPrimary;
          if (clearPrimaryError) {
            status(`Não foi possível definir a postagem principal: ${clearPrimaryError.message}`);
            return null;
          }
        }

        const row = {
          slug,
          source_lang: editing.sourceLang,
          cover_image: editing.coverImage || null,
          category: editing.category || null,
          author: $('#author').value.trim() || null,
          is_featured: editing.isFeatured,
          is_primary: editing.isPrimary,
          status: editing.status,
          published_at: editing.publishedAt || null,
        };
        if (editing.id) row.id = editing.id;

        status('Salvando…');
        const { data, error } = await supabase.from('posts').upsert(row).select().single();
        if (error) {
          status(`Erro ao salvar o post: ${error.message}`);
          return null;
        }
        editing.id = data.id;
        editing.slug = data.slug;
        editing.status = data.status;
        editing.publishedAt = data.published_at;
        editing.category = data.category ?? '';
        editing.author = data.author ?? '';
        editing.isFeatured = Boolean(data.is_featured);
        editing.isPrimary = Boolean(data.is_primary);

        const translationRow = {
          post_id: editing.id,
          lang: editing.sourceLang,
          ...original,
          is_original: true,
          manually_edited: true,
        };
        const { error: translationError } = await supabase
          .from('post_translations')
          .upsert(translationRow, { onConflict: 'post_id,lang' });
        if (translationError) {
          status(`Erro ao salvar o texto: ${translationError.message}`);
          return null;
        }
        editing.translations[editing.sourceLang] = { ...(editing.translations[editing.sourceLang] ?? {}), ...translationRow };
        return data;
      }

      async function saveLang(lang) {
        if (!editing.id) {
          if (!(await savePost({}))) return;
          if (lang === editing.sourceLang) {
            renderTabs();
            fillPanel(lang);
            status('Texto salvo nesta língua. A publicação ficou como rascunho.');
            await renderList();
            return;
          }
        }
        const values = readPanel(lang);
        if (!values.title) {
          status(`O título em ${lang.toUpperCase()} é obrigatório para salvar a língua.`);
          return;
        }
        const row = {
          post_id: editing.id,
          lang,
          ...values,
          is_original: lang === editing.sourceLang,
          manually_edited: true,
        };
        const { error } = await supabase.from('post_translations').upsert(row, { onConflict: 'post_id,lang' });
        if (error) {
          status(`Erro ao salvar: ${error.message}`);
          return;
        }
        editing.translations[lang] = { ...(editing.translations[lang] ?? {}), ...row };
        renderTabs();
        fillPanel(lang);
        status('Salvo. Como foi correção à mão, a retradução automática não mexe mais nesta língua.');
      }

      async function callTranslate() {
        const { data } = await supabase.auth.getSession();
        const token = data?.session?.access_token;
        if (!token) {
          status('Sua sessão expirou. Entre de novo.');
          showView('login');
          return null;
        }
        status('Traduzindo com a DeepL…');
        const response = await fetch('/api/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ postId: editing.id }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) {
          status(payload.error ?? 'Falha na tradução.');
          return null;
        }
        return payload;
      }

      async function refreshEditor() {
        if (!editing.id) return;
        const { data } = await supabase.from('posts').select('*,post_translations(*)').eq('id', editing.id).single();
        if (!data) return;
        editing.status = data.status;
        editing.publishedAt = data.published_at;
        editing.coverImage = data.cover_image;
        editing.category = data.category ?? '';
        editing.author = data.author ?? '';
        editing.isFeatured = Boolean(data.is_featured);
        editing.isPrimary = Boolean(data.is_primary);
        editing.translations = { pt: null, es: null, en: null };
        for (const translation of data.post_translations ?? []) editing.translations[translation.lang] = translation;
        fillEditor();
      }

      $('#btn-save-draft').addEventListener('click', async () => {
        if (await savePost({})) {
          renderTabs();
          fillPanel(activeLang());
          status('Rascunho salvo.');
          await renderList();
        }
      });

      $('#btn-publish').addEventListener('click', async () => {
        if (!(await savePost({ publish: true }))) return;
        fillEditor();
        const result = await callTranslate();
        await refreshEditor();
        if (result) {
          const parts = [];
          if (result.translated.length) parts.push(`traduzido para ${result.translated.map((l) => l.toUpperCase()).join(' e ')}`);
          if (result.skipped.length) parts.push(`${result.skipped.map((l) => l.toUpperCase()).join(' e ')} ficaram como estão (editadas à mão)`);
          status(`Publicado! ${parts.join('; ')}.`);
        }
      });

      $('#btn-unpublish').addEventListener('click', async () => {
        if (!(await savePost({ unpublish: true }))) return;
        fillEditor();
        status('Post voltou a rascunho: some do site até publicar de novo.');
      });

      $('#btn-retranslate').addEventListener('click', async () => {
        // Garante que o texto original salvo é o que está na tela.
        if (!(await savePost({}))) return;
        const result = await callTranslate();
        await refreshEditor();
        if (result) {
          const parts = [];
          if (result.translated.length) parts.push(`retraduzido: ${result.translated.map((l) => l.toUpperCase()).join(' e ')}`);
          if (result.skipped.length) parts.push(`mantive ${result.skipped.map((l) => l.toUpperCase()).join(' e ')} (editadas à mão)`);
          status(parts.length ? parts.join('; ') + '.' : 'Nada para retraduzir: as duas línguas foram editadas à mão.');
        }
      });

      // ---------------------------------------------------------------- Início

      (async () => {
        if (!configured) {
          $('#login-error').textContent =
            'O Supabase ainda não está configurado neste ambiente (PUBLIC_SUPABASE_URL e PUBLIC_SUPABASE_ANON_KEY).';
          showView('login');
          return;
        }
        const { data } = await supabase.auth.getSession();
        const isRecoveryLink = window.location.hash.includes('type=recovery') || new URLSearchParams(window.location.search).has('code');
        if (data?.session && isRecoveryLink) {
          showView('login');
          setLoginMode('recovery');
        } else if (data?.session) await enterList();
        else showView('login');
        supabase.auth.onAuthStateChange((event) => {
          if (event === 'PASSWORD_RECOVERY') {
            showView('login');
            setLoginMode('recovery');
          }
          if (event === 'SIGNED_OUT') {
            currentUser = null;
            setLoginMode();
            showView('login');
          }
        });
      })();
    </script>
  </body>
</html>
