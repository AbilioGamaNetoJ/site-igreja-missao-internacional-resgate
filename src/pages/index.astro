---
import BaseLayout from '../layouts/BaseLayout.astro';

const translations = {
  pt: {
    nav: ['A igreja', 'Encontros', 'Ações', 'Localização'], eyebrow: 'São José · Santa Catarina',
    hero: 'Uma casa para quem chegou de longe.', intro: 'Fé, pertencimento e uma mesa aberta para pessoas de todas as nações.', primary: 'Ver horários', secondary: 'Planejar a visita',
    welcomeTitle: 'Aqui, cada história encontra lugar.', welcome: 'A Missão Internacional Resgate é uma comunidade cristã em São José que acolhe especialmente pessoas estrangeiras. Chegue como você está: há comunhão, cuidado e uma família para caminhar junto.',
    spanish: 'Cultos em espanhol', spanishCopy: 'Nossos encontros acontecem em espanhol. É um espaço de fé e pertencimento para a comunidade latina — e para todos que desejam participar.',
    timesTitle: 'Escolha o melhor momento para estar com a gente.', times: [['Sexta-feira', '20h — 21h30'], ['Sábado', '16h — 18h'], ['Domingo', '10h — 12h']],
    actionsTitle: 'Cuidado que se transforma em presença.', clothes: 'Roupas que circulam', clothesCopy: 'Doações de roupas compartilhadas com respeito e carinho por cada história.', lunch: 'Mesa compartilhada', lunchCopy: 'Em alguns encontros, cada pessoa leva um pouco de alimento. Juntos, fazemos um almoço cheio de conversa e amizade.',
    whatsapp: 'Chamar no WhatsApp', call: 'Ligar agora', talk: 'Fale conosco',
    galleryTitle: 'Um espaço feito para pertencer.', gallery: 'Bandeiras, portas abertas e pessoas de muitos lugares: um pouco da nossa casa.',
    locationTitle: 'Sua cadeira está esperando.', address: 'Rua Vereador Manoel Mariano, 2014\nForquilhinhas · São José · SC', mapTitle: 'Encontre a gente', mapCopy: 'A área do mapa está pronta para receber a localização oficial da igreja assim que ela estiver disponível.',
    contactTitle: 'Fale com a gente', contactCopy: 'Ligue ou chame no WhatsApp. Se preferir, venha nos visitar em um dos horários de encontro.',
    footerVisit: 'Venha como você está.', footerAbout: 'Uma comunidade cristã em São José que recebe pessoas, histórias e nações.', footerTimes: 'Horários', footerPlace: 'Endereço', footerLinks: 'Navegação', back: 'Voltar ao início', rights: 'Missão Internacional Resgate. Todos os direitos reservados.'
  },
  es: {
    nav: ['La iglesia', 'Encuentros', 'Acciones', 'Ubicación'], eyebrow: 'São José · Santa Catarina',
    hero: 'Un hogar para quien llegó de lejos.', intro: 'Fe, pertenencia y una mesa abierta para personas de todas las naciones.', primary: 'Ver horarios', secondary: 'Planear la visita',
    welcomeTitle: 'Aquí, cada historia encuentra lugar.', welcome: 'Missão Internacional Resgate es una comunidad cristiana en São José que acoge especialmente a personas extranjeras. Llega tal como eres: hay comunión, cuidado y una familia para caminar juntos.',
    spanish: 'Cultos en español', spanishCopy: 'Nuestros encuentros se realizan en español. Es un espacio de fe y pertenencia para la comunidad latina y para todos los que quieren participar.',
    timesTitle: 'Elige el mejor momento para estar con nosotros.', times: [['Viernes', '20:00 — 21:30'], ['Sábado', '16:00 — 18:00'], ['Domingo', '10:00 — 12:00']],
    actionsTitle: 'Cuidado que se transforma en presencia.', clothes: 'Ropa que circula', clothesCopy: 'Donaciones de ropa compartidas con respeto y cariño por cada historia.', lunch: 'Mesa compartida', lunchCopy: 'En algunos encuentros, cada persona lleva un poco de comida. Juntos hacemos un almuerzo lleno de conversación y amistad.',
    whatsapp: 'Escribir por WhatsApp', call: 'Llamar ahora', talk: 'Habla con nosotros',
    galleryTitle: 'Un espacio hecho para pertenecer.', gallery: 'Banderas, puertas abiertas y personas de muchos lugares: un poco de nuestro hogar.',
    locationTitle: 'Tu silla te está esperando.', address: 'Rua Vereador Manoel Mariano, 2014\nForquilhinhas · São José · SC', mapTitle: 'Encuéntranos', mapCopy: 'El área del mapa está lista para recibir la ubicación oficial de la iglesia cuando esté disponible.',
    contactTitle: 'Habla con nosotros', contactCopy: 'Llama o escríbenos por WhatsApp. Si prefieres, visítanos en uno de los horarios de encuentro.',
    footerVisit: 'Ven tal como eres.', footerAbout: 'Una comunidad cristiana en São José que recibe personas, historias y naciones.', footerTimes: 'Horarios', footerPlace: 'Dirección', footerLinks: 'Navegación', back: 'Volver al inicio', rights: 'Missão Internacional Resgate. Todos los derechos reservados.'
  },
  en: {
    nav: ['The church', 'Gatherings', 'Outreach', 'Location'], eyebrow: 'São José · Santa Catarina',
    hero: 'A home for those who arrived from afar.', intro: 'Faith, belonging, and an open table for people from every nation.', primary: 'See gathering times', secondary: 'Plan your visit',
    welcomeTitle: 'Every story finds a place here.', welcome: 'Missão Internacional Resgate is a Christian community in São José that especially welcomes people from abroad. Come as you are: there is fellowship, care, and a family to walk alongside you.',
    spanish: 'Services in Spanish', spanishCopy: 'Our gatherings take place in Spanish. It is a space of faith and belonging for the Latin community and everyone who wishes to take part.',
    timesTitle: 'Choose the best time to be with us.', times: [['Friday', '8:00 PM — 9:30 PM'], ['Saturday', '4:00 PM — 6:00 PM'], ['Sunday', '10:00 AM — 12:00 PM']],
    actionsTitle: 'Care that becomes presence.', clothes: 'Clothes that keep moving', clothesCopy: 'Clothing donations shared with respect and care for every story.', lunch: 'A shared table', lunchCopy: 'At some gatherings, each person brings a little food. Together, we make a lunch full of conversation and friendship.',
    whatsapp: 'Message on WhatsApp', call: 'Call now', talk: 'Talk to us',
    galleryTitle: 'A place made for belonging.', gallery: 'Flags, open doors, and people from many places: a glimpse of our home.',
    locationTitle: 'Your seat is waiting.', address: 'Rua Vereador Manoel Mariano, 2014\nForquilhinhas · São José · SC', mapTitle: 'Find us', mapCopy: 'The map area is ready to receive the church’s official location as soon as it becomes available.',
    contactTitle: 'Talk to us', contactCopy: 'Call or message us on WhatsApp. You are also welcome to visit during one of our gatherings.',
    footerVisit: 'Come as you are.', footerAbout: 'A Christian community in São José that receives people, stories, and nations.', footerTimes: 'Gathering times', footerPlace: 'Address', footerLinks: 'Explore', back: 'Back to the top', rights: 'Missão Internacional Resgate. All rights reserved.'
  }
};
const logo = '/logos/LOGO%20iglesia%20imprimirr.png';
const whatsappHref = 'https://wa.me/5548988313964';
const telHref = 'tel:048988313964';
const phoneDisplay = '(48) 98831-3964';
---

<BaseLayout>
  <header class="site-header" id="topo">
    <a class="brand" href="#topo" aria-label="Missão Internacional Resgate"><span class="logo-lockup"><img src={logo} alt="Missão Internacional Resgate" /></span></a>
    <nav aria-label="Navegação principal"><a href="#igreja" data-i18n="nav.0">A igreja</a><a href="#encontros" data-i18n="nav.1">Encontros</a><a href="#acoes" data-i18n="nav.2">Ações</a><a href="#localizacao" data-i18n="nav.3">Localização</a></nav>
    <div class="header-tools">
      <a class="nav-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-i18n="talk">Fale conosco</a>
      <div class="language-switcher" aria-label="Escolher idioma"><button class="language active" data-lang="pt" aria-pressed="true" title="Português do Brasil"><span>🇧🇷</span><b>PT</b></button><button class="language" data-lang="es" aria-pressed="false" title="Español Latinoamérica"><span>🇪🇸</span><b>ES</b></button><button class="language" data-lang="en" aria-pressed="false" title="English (United States)"><span>🇺🇸</span><b>EN</b></button></div>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image" role="img" aria-label="Fachada da Missão Internacional Resgate"></div><div class="hero-veil"></div><div class="hero-glow"></div>
      <div class="hero-content frame"><div class="hero-kicker"><span class="pulse-dot"></span><p class="eyebrow" data-i18n="eyebrow">São José · Santa Catarina</p></div><h1 id="hero-title" data-i18n="hero">Uma casa para quem chegou de longe.</h1><p class="hero-intro" data-i18n="intro">Fé, pertencimento e uma mesa aberta para pessoas de todas as nações.</p><div class="hero-actions"><a class="button primary" href="#encontros" data-i18n="primary">Ver horários</a><a class="button whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-i18n="whatsapp">Chamar no WhatsApp</a></div></div>
      <a class="discover" href="#igreja" aria-label="Conhecer a igreja"><span></span><small>CONHEÇA</small></a>
    </section>

    <section class="intro-section section frame reveal" id="igreja"><div class="section-marker"><span>01</span><i></i><small data-i18n="nav.0">A igreja</small></div><div class="intro-grid"><h2 data-i18n="welcomeTitle">Aqui, cada história encontra lugar.</h2><div class="intro-copy"><p data-i18n="welcome">A Missão Internacional Resgate é uma comunidade cristã em São José que acolhe especialmente pessoas estrangeiras. Chegue como você está: há comunhão, cuidado e uma família para caminhar junto.</p><div class="spanish-note"><div class="note-icon">ES</div><div><p class="eyebrow" data-i18n="spanish">Cultos em espanhol</p><p data-i18n="spanishCopy">Nossos encontros acontecem em espanhol. É um espaço de fé e pertencimento para a comunidade latina — e para todos que desejam participar.</p></div></div></div></div></section>

    <section class="schedule section" id="encontros"><div class="schedule-backdrop"></div><div class="frame reveal"><div class="section-marker light"><span>02</span><i></i><small data-i18n="nav.1">Encontros</small></div><div class="schedule-heading"><h2 data-i18n="timesTitle">Escolha o melhor momento para estar com a gente.</h2><p>Todos são bem-vindos.</p></div><div class="time-list">{translations.pt.times.map((item, index) => <article class="time-card"><div class="time-number">{String(index + 1).padStart(2, '0')}</div><h3 data-time-day={index}>{item[0]}</h3><p data-time-hour={index}>{item[1]}</p><span class="card-orbit"></span></article>)}</div></div></section>

    <section class="actions section frame reveal" id="acoes">
      <div class="section-marker"><span>03</span><i></i><small data-i18n="nav.2">Ações</small></div>
      <div class="actions-heading"><h2 data-i18n="actionsTitle">Cuidado que se transforma em presença.</h2><p>Pequenos gestos que fortalecem a nossa comunidade.</p></div>
      <div class="action-grid">
        <article class="action-card clothing">
          <figure class="action-photo"><img src="/image1.jpeg" alt="Comunidade reunida em um encontro da Missão Internacional Resgate" loading="lazy" /></figure>
          <div class="action-body"><div class="card-icon">✦</div><div><h3 data-i18n="clothes">Roupas que circulam</h3><p data-i18n="clothesCopy">Doações de roupas compartilhadas com respeito e carinho por cada história.</p></div></div>
          <span class="card-count">01</span>
        </article>
        <article class="action-card lunch">
          <figure class="action-photo"><img src="/image2.jpeg" alt="Mesa preparada durante um encontro da igreja" loading="lazy" /></figure>
          <div class="action-body"><div class="card-icon">✳</div><div><h3 data-i18n="lunch">Mesa compartilhada</h3><p data-i18n="lunchCopy">Em alguns encontros, cada pessoa leva um pouco de alimento. Juntos, fazemos um almoço cheio de conversa e amizade.</p></div></div>
          <span class="card-count">02</span>
        </article>
      </div>
    </section>

    <section class="gallery section reveal"><div class="frame"><div class="section-marker"><span>04</span><i></i><small>Casa</small></div><div class="gallery-header"><h2 data-i18n="galleryTitle">Um espaço feito para pertencer.</h2><p data-i18n="gallery">Bandeiras, portas abertas e pessoas de muitos lugares: um pouco da nossa casa.</p></div></div><div class="gallery-grid"><figure class="gallery-main"><img src="/igreja-espaco.jpeg" alt="Espaço interno da igreja com bandeiras de vários países" loading="lazy" /><figcaption>Uma família de muitas nações</figcaption></figure><figure><img src="/image5.jpeg" alt="Detalhe de um encontro da Missão Internacional Resgate" loading="lazy" /></figure><figure><img src="/igreja-espaco2.jpeg" alt="Ambiente da igreja" loading="lazy" /></figure></div></section>

    <section class="location section frame reveal" id="localizacao"><div class="section-marker"><span>05</span><i></i><small data-i18n="nav.3">Localização</small></div><div class="location-grid"><div class="visit-copy"><h2 data-i18n="locationTitle">Sua cadeira está esperando.</h2><address data-i18n="address">Rua Vereador Manoel Mariano, 2014<br />Forquilhinhas · São José · SC</address><div class="contact-box"><p class="eyebrow" data-i18n="contactTitle">Fale com a gente</p><p data-i18n="contactCopy">Ligue ou chame no WhatsApp. Se preferir, venha nos visitar em um dos horários de encontro.</p><div class="contact-actions"><a class="button whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-i18n="whatsapp">Chamar no WhatsApp</a><a class="button call" href={telHref} data-i18n="call">Ligar agora</a></div><a class="phone-line" href={telHref}>{phoneDisplay}</a></div></div><aside class="map-placeholder"><div class="map-rings"><i></i><i></i><i></i></div><div class="map-content"><span class="pin">✦</span><p class="eyebrow" data-i18n="mapTitle">Encontre a gente</p><p data-i18n="mapCopy">A área do mapa está pronta para receber a localização oficial da igreja assim que ela estiver disponível.</p><small>MAPA EM BREVE</small></div></aside></div></section>
  </main>

  <footer class="site-footer"><div class="footer-orb orb-one"></div><div class="footer-orb orb-two"></div><div class="footer-top frame"><div class="footer-intro"><p class="eyebrow">MISSÃO INTERNACIONAL RESGATE</p><h2 data-i18n="footerVisit">Venha como você está.</h2><p data-i18n="footerAbout">Uma comunidade cristã em São José que recebe pessoas, histórias e nações.</p></div><span class="logo-lockup footer-logo"><img src={logo} alt="Missão Internacional Resgate" /></span></div><div class="footer-grid frame"><div><p class="footer-label" data-i18n="footerTimes">Horários</p><p>Sexta · 20h — 21h30<br />Sábado · 16h — 18h<br />Domingo · 10h — 12h</p></div><div><p class="footer-label" data-i18n="footerPlace">Endereço</p><p>Rua Vereador Manoel Mariano, 2014<br />Forquilhinhas · São José · SC</p><a class="footer-phone" href={telHref}>{phoneDisplay}</a><a class="button whatsapp footer-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer" data-i18n="whatsapp">Chamar no WhatsApp</a></div><div><p class="footer-label" data-i18n="footerLinks">Navegação</p><a href="#igreja" data-i18n="nav.0">A igreja</a><a href="#encontros" data-i18n="nav.1">Encontros</a><a href="#localizacao" data-i18n="nav.3">Localização</a></div><a class="back-top" href="#topo" data-i18n="back">Voltar ao início</a></div><div class="footer-bottom frame"><p data-i18n="rights">Missão Internacional Resgate. Todos os direitos reservados.</p><span>São José, SC · Brasil</span></div></footer>

  <script define:vars={{ translations }}>
    const findValue = (object, key) => key.split('.').reduce((value, part) => value?.[part], object);
    const updateLanguage = (lang) => { const copy = translations[lang]; document.documentElement.lang = lang === 'pt' ? 'pt-BR' : lang; document.querySelectorAll('[data-i18n]').forEach((element) => { const value = findValue(copy, element.dataset.i18n); if (value) element.innerHTML = String(value).replace(/\n/g, '<br>'); }); copy.times.forEach((item, index) => { document.querySelector(`[data-time-day="${index}"]`).textContent = item[0]; document.querySelector(`[data-time-hour="${index}"]`).textContent = item[1]; }); document.querySelectorAll('.language').forEach((button) => { const active = button.dataset.lang === lang; button.classList.toggle('active', active); button.setAttribute('aria-pressed', String(active)); }); localStorage.setItem('mir-language', lang); };
    document.querySelectorAll('.language').forEach((button) => button.addEventListener('click', () => updateLanguage(button.dataset.lang)));
    const savedLanguage = localStorage.getItem('mir-language'); if (savedLanguage && translations[savedLanguage]) updateLanguage(savedLanguage);
    const header = document.querySelector('.site-header'), hero = document.querySelector('.hero'), sections = [...document.querySelectorAll('main section[id]')];
    const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('is-visible'); }), { threshold: .14 }); document.querySelectorAll('.reveal').forEach((section) => revealObserver.observe(section));
    const navigationObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) document.querySelectorAll('.site-header nav a').forEach((link) => link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`)); }), { rootMargin: '-35% 0px -55% 0px' }); sections.forEach((section) => navigationObserver.observe(section));
    window.addEventListener('scroll', () => header.classList.toggle('scrolled', window.scrollY > 24), { passive: true });
    hero.addEventListener('pointermove', (event) => { if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; const x = (event.clientX / window.innerWidth - .5) * 10, y = (event.clientY / window.innerHeight - .5) * 8; hero.style.setProperty('--hero-x', `${x}px`); hero.style.setProperty('--hero-y', `${y}px`); });
  </script>
</BaseLayout>
