---
// Atalhos para as outras páginas, em linha, sobre fundo claro.
import { content } from '../i18n/content.js';
import { navPages, pathFor } from '../i18n/routes.js';

const { lang, current, title } = Astro.props;
const t = content[lang];
const pages = navPages.filter((id) => id !== current);
---

<section class="quick-links section">
  <div class="frame" data-reveal>
    {title && <h2>{title}</h2>}
    <ul>
      {pages.map((id) => <li><a class="button button-dark" href={pathFor(id, lang)}>{t.nav[id]}</a></li>)}
    </ul>
  </div>
</section>

<style>
  .quick-links {
    padding-block: clamp(3.5rem, 6vw, 5rem);
  }

  h2 {
    margin-bottom: 32px;
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .button {
    min-width: 11rem;
  }

  @media (max-width: 600px) {
    li {
      flex: 1 1 100%;
    }

    .button {
      width: 100%;
    }
  }
</style>
