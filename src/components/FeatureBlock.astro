---
// Bloco de foto + título em caixa alta + subtítulo manuscrito + texto.
// Use reverse para alternar o lado da foto. O slot recebe botões ou informações extras.
import { imageSrcSet, imageUrl } from '../lib/images.js';

const { title, script, text, image, alt, position = 'center', reverse = false, variant = 'plain' } = Astro.props;
const optimizedImage = imageUrl(image, { width: 1280 });
---

<article class:list={['feature', `feature--${variant}`, { reverse }]} data-reveal>
  <figure class="feature-media">
    <img src={optimizedImage} srcset={imageSrcSet(image)} sizes="(max-width: 860px) calc(100vw - 40px), 45vw" width="1280" height="1280" alt={alt} loading="lazy" decoding="async" style={`object-position: ${position}`} />
  </figure>
  <div class="feature-copy">
    <h2 class="display-title">{title}</h2>
    <p class="script">{script}</p>
    <p class="body-text rich" set:html={text} />
    <slot />
  </div>
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .feature + :global(.feature) {
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  .feature--panel {
    position: relative;
    padding: clamp(1.25rem, 3vw, 2.75rem);
    overflow: hidden;
    border: 1px solid rgba(17, 18, 20, 0.07);
    border-radius: clamp(1.75rem, 3.4vw, 3.25rem);
    background: var(--white);
    box-shadow: 0 24px 54px rgba(30, 26, 19, 0.08);
  }

  .feature--panel::before {
    position: absolute;
    top: 0;
    left: clamp(1.25rem, 3vw, 2.75rem);
    width: clamp(3.5rem, 8vw, 6rem);
    height: 5px;
    border-radius: 0 0 999px 999px;
    background: var(--gold);
    content: '';
  }

  .feature--dark {
    border-color: rgba(255, 255, 255, 0.12);
    background: var(--ink);
    color: var(--white);
    box-shadow: 0 28px 60px rgba(17, 18, 20, 0.22);
  }

  .feature--dark .script {
    color: var(--gold);
  }

  .feature--dark .body-text {
    color: rgba(255, 255, 255, 0.78);
  }

  .feature--dark :global(.rich strong) {
    color: var(--gold-hover);
  }

  .reverse .feature-media {
    order: 2;
  }

  .feature-media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-photo);
    background: var(--paper);
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .display-title {
    /* "COMPARTILHADA" mede ~7,5em: o segundo valor do min() a mantém dentro da coluna em telas de 320px. */
    font-size: min(clamp(2.5rem, 5.2vw, 4.25rem), calc((100vw - 40px) / 8));
  }

  .script {
    margin-top: 14px;
  }

  .body-text {
    max-width: 540px;
    margin-top: 18px;
  }

  .feature-copy > :global(:not(h2, p)) {
    margin-top: 28px;
  }

  @media (max-width: 860px) {
    .feature {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .reverse .feature-media {
      order: 0;
    }

    .feature-media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 600px) {
    .feature--panel {
      padding: 1.25rem;
      border-radius: 1.75rem;
    }

    .feature-copy > :global(.button) {
      display: flex;
    }
  }
</style>
