---
// Frase grande centralizada que abre cada página interna, com um parágrafo de apoio.
const { title, text } = Astro.props;
---

<section class="statement section">
  <div class="statement-content frame" data-reveal>
    <h2>{title}</h2>
    {text && <p class="rich" set:html={text} />}
  </div>
</section>

<style>
  .statement {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 8% 12%, rgba(221, 186, 103, 0.2), transparent 18rem),
      var(--sand);
  }

  .statement::before,
  .statement::after {
    position: absolute;
    width: min(24vw, 320px);
    height: min(24vw, 320px);
    border: 1px solid rgba(157, 116, 40, 0.2);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .statement::before {
    top: -13vw;
    left: -8vw;
  }

  .statement::after {
    right: -12vw;
    bottom: -18vw;
  }

  .statement-content {
    position: relative;
    max-width: 980px;
    text-align: center;
  }

  .statement-content::before {
    display: block;
    width: 48px;
    height: 3px;
    margin: 0 auto 24px;
    background: var(--gold);
    content: '';
  }

  h2 {
    font-family: var(--display);
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  p {
    max-width: 760px;
    margin: 28px auto 0;
    color: var(--ink);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 400;
    line-height: 1.7;
  }
</style>
