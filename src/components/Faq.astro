---
// Perguntas frequentes que abrem e fecham (usa <details>, funciona sem JavaScript).
import Icon from './Icon.astro';

const { title, items } = Astro.props;
---

<section class="faq section">
<div class="faq-inner frame" data-reveal>
  <h2>{title}</h2>
  <div class="faq-box">
    {items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <span class="faq-icon"><Icon name="chevron-down" size={18} /></span>
        </summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</div>
</section>

<style>
  .faq {
    background: var(--paper);
  }

  .faq-inner {
    max-width: 820px;
  }

  h2 {
    margin-bottom: 32px;
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .faq-box {
    padding: 8px clamp(20px, 4vw, 40px);
    border: 2px solid var(--ink);
    border-radius: 18px;
    background: var(--white);
  }

  details + details {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    font-family: var(--display);
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 700;
    line-height: 1.25;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    transition: transform 0.25s ease, background-color 0.2s ease;
  }

  summary:hover .faq-icon {
    background: var(--gold);
  }

  details[open] .faq-icon {
    transform: rotate(180deg);
  }

  details p {
    max-width: 640px;
    padding-bottom: 24px;
    color: var(--muted);
    line-height: 1.7;
  }
</style>
