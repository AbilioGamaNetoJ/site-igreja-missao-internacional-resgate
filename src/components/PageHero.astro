---
// Banner das páginas internas. Com titleA/titleB mostra o nome da página em duas cores;
// com title mostra uma frase de destaque e, se houver, um botão.
import { imageSrcSet, imageUrl } from '../lib/images.js';

const { image, titleA, titleB, title, cta, mono = true } = Astro.props;
const optimizedImage = imageUrl(image, { width: 1280 });
---

<section class:list={['page-hero', { headline: !!title }]}>
  <img class:list={['page-hero-image', { mono }]} src={optimizedImage} srcset={imageSrcSet(image)} sizes="100vw" width="1280" height="853" alt="" fetchpriority="high" decoding="async" />
  <div class="page-hero-content frame">
    <h1>
      {titleA ? <Fragment><span>{titleA}</span> <span class="accent">{titleB}</span></Fragment> : title}
    </h1>
    {cta && <a class="button button-gold" href={cta.href}>{cta.label}</a>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(300px, 36vw, 460px);
    overflow: hidden;
    background: var(--black);
    color: var(--white);
    text-align: center;
  }

  .page-hero.headline {
    min-height: clamp(440px, 52vw, 620px);
  }

  .page-hero-image {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.45);
  }

  .page-hero-image.mono {
    filter: grayscale(1) contrast(1.08) brightness(0.5);
  }

  .page-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding-block: 64px;
  }

  @media (max-width: 600px) {
    .page-hero-content {
      gap: 24px;
      padding-block: 48px;
    }
  }

  h1 {
    font-family: var(--display);
    /* A palavra mais larga ("ENCUENTROS") mede 6,65em. O segundo valor do min() a mantém dentro das margens em telas estreitas. */
    font-size: min(clamp(3.1rem, 9.5vw, 7.75rem), calc((100vw - 40px) / 7));
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .accent {
    color: var(--gold);
  }

  .headline h1 {
    max-width: 14ch;
    font-size: clamp(2.6rem, 6.2vw, 5.4rem);
    letter-spacing: -0.015em;
    text-transform: none;
    text-wrap: balance;
  }
</style>
