---
import Icon from './Icon.astro';
import { content } from '../i18n/content.js';
import { navPages, pathFor } from '../i18n/routes.js';
import { site, whatsappLink } from '../data/site.js';
import { siteLink } from '../lib/site-cms.js';

const { lang } = Astro.props;
const t = Astro.props.contentData ?? content[lang];
const churchSite = Astro.props.siteData ?? site;
const year = new Date().getFullYear();
const navLinkKey = (id) => `nav${id.charAt(0).toUpperCase()}${id.slice(1)}`;
---

<footer class="site-footer">
  <div class="footer-grid frame">
    <div class="footer-brand">
      <img src={churchSite.symbol.src} width={churchSite.symbol.width} height={churchSite.symbol.height} alt={churchSite.name} loading="lazy" />
      <p>{t.footer.about}</p>
      <a class="button button-light" href={siteLink(churchSite, 'footerVisit', pathFor('visit', lang))}>{t.ui.planVisit}</a>
    </div>

    <div>
      <h2 class="footer-title">{t.footer.navTitle}</h2>
      <ul class="footer-list">
        {navPages.map((id) => <li><a href={siteLink(churchSite, navLinkKey(id), pathFor(id, lang))}>{t.nav[id]}</a></li>)}
        <li><a href={siteLink(churchSite, 'navPrivacy', pathFor('privacy', lang))}>{t.footer.privacy}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="footer-title">{t.footer.timesTitle}</h2>
      <ul class="footer-list">
        {t.times.map((time) => <li><strong>{time.day}</strong><br />{time.hour}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer-title">{t.footer.contactTitle}</h2>
      <ul class="footer-list footer-contact">
        <li><Icon name="phone" size={18} /><a href={churchSite.phone.href}>{churchSite.phone.display}</a></li>
        <li><Icon name="whatsapp" size={18} /><a href={whatsappLink(t.ui.whatsappMessage, churchSite)} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        <li><Icon name="pin" size={18} /><a href={churchSite.map.link} target="_blank" rel="noopener noreferrer">{churchSite.address.street}<br />{churchSite.address.city}</a></li>
        {churchSite.email && <li><Icon name="mail" size={18} /><a href={`mailto:${churchSite.email}`}>{churchSite.email}</a></li>}
      </ul>
    </div>
  </div>

  <div class="footer-bottom frame">
    <ul class="social" aria-label={t.footer.socialTitle}>
      {churchSite.social.map((network) => (
        <li><a href={network.href || '#'} aria-label={network.name} target={network.href ? '_blank' : undefined} rel={network.href ? 'noopener noreferrer' : undefined}><Icon name={network.icon} size={18} /></a></li>
      ))}
    </ul>
    <p>© {year} {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(4rem, 8vw, 6rem) 0 2rem;
    background: var(--black);
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.92rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.25fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }

  .footer-brand img {
    width: 104px;
    height: auto;
  }

  .footer-brand p {
    max-width: 260px;
    margin: 20px 0 24px;
    line-height: 1.65;
  }

  .footer-title {
    margin-bottom: 18px;
    color: var(--gold);
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .footer-list {
    display: grid;
    gap: 12px;
    line-height: 1.5;
  }

  .footer-list strong {
    color: var(--white);
    font-weight: 700;
  }

  .footer-list a {
    color: inherit;
    /* Um e-mail comprido, quando houver, não pode empurrar a página para o lado. */
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-list a:hover {
    color: var(--gold);
  }

  .footer-contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: start;
  }

  .footer-contact :global(svg) {
    margin-top: 2px;
    color: var(--gold);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-top: 32px;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.8rem;
    text-align: center;
  }

  .social {
    display: flex;
    gap: 12px;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--white);
    color: var(--black);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .social a:hover {
    background: var(--gold);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* Navegação e horários ficam lado a lado; marca e contato ocupam a linha toda. */
  @media (max-width: 560px) {
    .footer-grid {
      gap: 36px 24px;
    }

    .footer-grid > :last-child {
      grid-column: 1 / -1;
    }

    .footer-bottom p {
      text-wrap: balance;
    }
  }
</style>
