---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n/content.js';
import { defaultLang, languages, pathFor } from '../i18n/routes.js';
import { site } from '../data/site.js';
import { structuredData } from '../data/seo.js';

const { lang, page } = Astro.props;
const t = content[lang];
const pageTitle = t.meta.titles[page];
const title = page === 'home' ? `${site.name} | ${pageTitle}` : `${pageTitle} | ${site.name}`;
const description = t.meta.descriptions[page];
const base = Astro.site;

// Canonical, hreflang e a imagem de compartilhamento precisam do domínio (site.url em src/data/site.js).
const canonical = base && new URL(pathFor(page, lang), base).href;
const shareImage = base && new URL(site.shareImage.src, base).href;
const alternates = base
  ? [
      ...Object.entries(languages).map(([code, language]) => ({ hreflang: language.htmlLang, href: new URL(pathFor(page, code), base).href })),
      { hreflang: 'x-default', href: new URL(pathFor(page, defaultLang), base).href },
    ]
  : [];
const otherLocales = Object.entries(languages).filter(([code]) => code !== lang).map(([, language]) => language.ogLocale);
const jsonLd = structuredData({ lang, page, title, base });
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Prévia do link no WhatsApp, Facebook e outras redes -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {otherLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && (
      <Fragment>
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content={String(site.shareImage.width)} />
        <meta property="og:image:height" content={String(site.shareImage.height)} />
        <meta property="og:image:alt" content={t.meta.shareImageAlt} />
      </Fragment>
    )}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />

    <!-- Dados estruturados (schema.org) para buscadores e assistentes de IA -->
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@300..900&family=League+Spartan:wght@600..800&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.ui.skip}</a>
    <Header lang={lang} page={page} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const header = document.querySelector('[data-header]');
      const toggle = header.querySelector('[data-menu-toggle]');
      const toggleLabel = header.querySelector('[data-menu-label]');

      const setMenu = (open) => {
        header.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggleLabel.textContent = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
        document.body.classList.toggle('menu-open', open);
      };

      toggle.addEventListener('click', () => setMenu(!header.hasAttribute('data-open')));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && header.hasAttribute('data-open')) {
          setMenu(false);
          toggle.focus();
        }
      });
      window.matchMedia('(min-width: 1081px)').addEventListener('change', (event) => event.matches && setMenu(false));

      // A barra encolhe 20px. Entrar só depois disso evita a faixa branca do espaçador;
      // sair um pouco antes impede o liga-desliga se o scroll oscilar em cima do limite.
      const SCROLL_ENTER = 32;
      const SCROLL_EXIT = 20;
      let compact = false;

      const updateHeader = () => {
        const y = window.scrollY;
        if (!compact && y > SCROLL_ENTER) compact = true;
        else if (compact && y <= SCROLL_EXIT) compact = false;
        header.classList.toggle('is-scrolled', compact);
      };
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }), { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
    </script>
  </body>
</html>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }
</style>
