---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n/content.js';
import { defaultLang, languages, pathFor } from '../i18n/routes.js';
import { site } from '../data/site.js';
import { structuredData } from '../data/seo.js';
import kumbhSansFont from '../assets/fonts/KumbhSans.woff2';
import leagueSpartanFont from '../assets/fonts/LeagueSpartan.woff2';

// `page` busca título, descrição e endereços em src/i18n/content.js e src/i18n/routes.js.
// `meta` sobrepõe tudo isso para páginas dinâmicas (artigos do blog):
// { title, description, path, languagePaths: { pt, es, en }, image: { src, alt },
//   type: 'article', publishedTime, modifiedTime, noindex, jsonLd }
const { lang, page, meta } = Astro.props;
const t = content[lang];
const pageTitle = meta?.title ?? t.meta.titles[page];
const title = !meta && page === 'home' ? `${site.name} | ${pageTitle}` : `${pageTitle} | ${site.name}`;
const description = meta?.description ?? t.meta.descriptions[page];
const base = Astro.site;
const pagePath = meta?.noCanonical ? null : meta?.path ?? pathFor(page, lang);
// Páginas utilitárias, como a 404, não representam conteúdo equivalente nos
// outros idiomas e não devem gerar hreflang nem dados estruturados.
const languagePaths = meta?.noAlternates
  ? null
  : meta?.languagePaths ?? Object.fromEntries(Object.keys(languages).map((code) => [code, pathFor(page, code)]));

// Canonical, hreflang e a imagem de compartilhamento precisam do domínio (site.url em src/data/site.js).
const canonical = base && pagePath ? new URL(pagePath, base).href : null;
const isArticle = meta?.type === 'article';
const shareImage = meta?.image?.src ?? (base && new URL(site.shareImage.src, base).href);
const shareImageAlt = meta?.image?.alt ?? t.meta.shareImageAlt;
const alternates = base && languagePaths
  ? [
      ...Object.entries(languages).map(([code, language]) => ({ hreflang: language.htmlLang, href: new URL(languagePaths[code], base).href })),
      { hreflang: 'x-default', href: new URL(languagePaths[defaultLang], base).href },
    ]
  : [];
const otherLocales = Object.entries(languages).filter(([code]) => code !== lang).map(([, language]) => language.ogLocale);
const jsonLd = meta?.noStructuredData ? null : meta?.jsonLd ?? structuredData({ lang, page, title, base });
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {meta?.noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/apple-touch-icon-180.png" />

    <!-- Prévia do link no WhatsApp, Facebook e outras redes -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {otherLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
    {canonical && <meta property="og:url" content={canonical} />}
    {isArticle && meta.publishedTime && <meta property="article:published_time" content={meta.publishedTime} />}
    {isArticle && meta.modifiedTime && <meta property="article:modified_time" content={meta.modifiedTime} />}
    {shareImage && (
      <Fragment>
        <meta property="og:image" content={shareImage} />
        {!meta?.image && (
          <Fragment>
            <meta property="og:image:width" content={String(site.shareImage.width)} />
            <meta property="og:image:height" content={String(site.shareImage.height)} />
          </Fragment>
        )}
        <meta property="og:image:alt" content={shareImageAlt} />
      </Fragment>
    )}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />

    <!-- Dados estruturados (schema.org) para buscadores e assistentes de IA -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <link rel="preload" href={leagueSpartanFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={kumbhSansFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t.ui.skip}</a>
    <Header lang={lang} page={page} altPaths={meta?.languagePaths} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const header = document.querySelector('[data-header]');
      const toggle = header.querySelector('[data-menu-toggle]');
      const toggleLabel = header.querySelector('[data-menu-label]');

      const setMenu = (open) => {
        header.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggleLabel.textContent = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
        document.body.classList.toggle('menu-open', open);
      };

      toggle.addEventListener('click', () => setMenu(!header.hasAttribute('data-open')));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && header.hasAttribute('data-open')) {
          setMenu(false);
          toggle.focus();
        }
      });
      window.matchMedia('(min-width: 1081px)').addEventListener('change', (event) => event.matches && setMenu(false));

      // A barra encolhe 20px. Entrar só depois disso evita a faixa branca do espaçador;
      // sair um pouco antes impede o liga-desliga se o scroll oscilar em cima do limite.
      const SCROLL_ENTER = 32;
      const SCROLL_EXIT = 20;
      let compact = false;

      const updateHeader = () => {
        const y = window.scrollY;
        if (!compact && y > SCROLL_ENTER) compact = true;
        else if (compact && y <= SCROLL_EXIT) compact = false;
        header.classList.toggle('is-scrolled', compact);
      };
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }), { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
    </script>
  </body>
</html>

<style is:global>
  body.menu-open {
    overflow: hidden;
  }
</style>
