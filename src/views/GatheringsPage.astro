---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IntroStatement from '../components/IntroStatement.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import Story from '../components/Story.astro';
import QuickLinks from '../components/QuickLinks.astro';
import Icon from '../components/Icon.astro';
import { content } from '../i18n/content.js';
import { site, whatsappLink } from '../data/site.js';
import { photos } from '../data/photos.js';

const { lang } = Astro.props;
const t = content[lang];
const gatherings = t.gatherings;
const [expect, firstTime] = gatherings.blocks;
---

<BaseLayout lang={lang} page="gatherings">
  <PageHero image={photos.praise} titleA={gatherings.hero.a} titleB={gatherings.hero.b} />
  <IntroStatement title={gatherings.statement} text={gatherings.intro} />

  <section class="times section section-dark">
    <div class="frame" data-reveal>
      <h2>{gatherings.timesTitle}</h2>
      <ul class="times-grid">
        {t.times.map((time) => (
          <li>
            <span class="time-day">{time.day}</span>
            <span class="time-hour">{time.hour}</span>
          </li>
        ))}
      </ul>
      <p class="times-address"><Icon name="pin" size={18} /><span>{site.address.street}</span><span class="times-sep" aria-hidden="true">·</span><span>{site.address.city}</span></p>
    </div>
  </section>

  <Story>
    <FeatureBlock {...expect} image={photos.preaching} alt={t.photos.preaching} />
    <FeatureBlock {...firstTime} image={photos.hall} alt={t.photos.hall} reverse>
      <a class="button button-gold" href={whatsappLink(t.ui.whatsappMessage)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20} />{t.ui.whatsapp}</a>
    </FeatureBlock>
  </Story>

  <QuickLinks lang={lang} current="gatherings" title={t.ui.readyTitle} />
</BaseLayout>

<style>
  h2 {
    margin-bottom: 48px;
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-transform: uppercase;
  }

  .times-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .times-grid li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 32px 16px;
    border-top: 3px solid var(--gold);
    text-align: center;
  }

  .time-day {
    color: var(--gold);
    font-family: var(--script);
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    line-height: 1.25;
    letter-spacing: 0.04em;
    word-spacing: 0.18em;
  }

  .time-hour {
    font-family: var(--display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 700;
  }

  .times-address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
    color: rgba(255, 255, 255, 0.75);
    text-align: center;
  }

  .times-address :global(svg) {
    color: var(--gold);
  }

  @media (max-width: 760px) {
    .times-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .times-grid li {
      padding: 24px 16px;
    }
  }

  /* No celular o endereço vira duas linhas, sem o "·" que ficaria sobrando no fim da primeira. */
  @media (max-width: 600px) {
    h2 {
      margin-bottom: 32px;
    }

    .times-address {
      flex-direction: column;
      gap: 2px;
      margin-top: 24px;
    }

    .times-address :global(svg) {
      margin-bottom: 4px;
    }

    .times-address span {
      text-wrap: balance;
    }

    .times-sep {
      display: none;
    }
  }
</style>
