---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import QuickLinks from '../components/QuickLinks.astro';
import Story from '../components/Story.astro';
import DarkBand from '../components/DarkBand.astro';
import { content } from '../i18n/content.js';
import { blogPath, languages, pathFor } from '../i18n/routes.js';
import { photos } from '../data/photos.js';
import { categoryName, fetchFeaturedPosts, translationsByLang } from '../lib/supabase.js';

const { lang } = Astro.props;
const t = content[lang];
const home = t.home;
const pillarPages = ['church', 'gatherings', 'outreach'];
const featuredPosts = await fetchFeaturedPosts();
const featuredDateFormatter = new Intl.DateTimeFormat(languages[lang].htmlLang, { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout lang={lang} page="home">
  <section class="hero section-dark">
    <img class="hero-image" src={photos.congregation} alt="" fetchpriority="high" />
    <div class="hero-content frame">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.title}</h1>
      <p class="hero-welcome">{home.hero.welcome}</p>
      <p class="hero-schedule">{home.hero.schedule.split(' · ').map((item, index) => <Fragment>{index > 0 && ' '}<span>{item}</span></Fragment>)}</p>
      <p class="hero-intro">{home.hero.intro}</p>
      <a class="button button-gold" href={pathFor('visit', lang)}>{t.ui.planVisit}</a>
    </div>
  </section>

  <nav class="pillar-band section-dark" aria-label={home.pillars.map((pillar) => pillar.title).join(', ')}>
    <ul class="frame">
      {home.pillars.map((pillar, index) => (
        <li>
          <a href={`#pilar-${index + 1}`}>
            <Icon name="arrow-down" size={44} />
            <span>{pillar.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <Story>
    <div class="pillars-grid">
      <div class="pillars-list">
        {home.pillars.map((pillar, index) => (
          <article class="pillar" id={`pilar-${index + 1}`} data-reveal>
            <h2 class="display-title">{pillar.title}</h2>
            <p class="script">{pillar.script}</p>
            <p class="body-text rich" set:html={pillar.text} />
            <a class="arrow-link" href={pathFor(pillarPages[index], lang)}>{pillar.link}<Icon name="arrow-right" size={18} /></a>
          </article>
        ))}
      </div>
      <figure class="pillars-photo">
        <img src={photos.preaching} alt={t.photos.preaching} loading="lazy" />
      </figure>
    </div>
  </Story>

  {featuredPosts.length > 0 && (
    <section class="featured-posts section-dark" aria-labelledby="featured-posts-title">
      <div class="frame">
        <div class="featured-posts-heading" data-reveal>
          <div>
            <p class="eyebrow">{home.featured.eyebrow}</p>
            <h2 id="featured-posts-title">{home.featured.title}</h2>
          </div>
          <div>
            <p>{home.featured.intro}</p>
            <a class="arrow-link featured-posts-link" href={blogPath(lang)}>{home.featured.link}<Icon name="arrow-right" size={18} /></a>
          </div>
        </div>

        <ul class="featured-posts-grid">
          {featuredPosts.map((post, index) => {
            const translation = translationsByLang(post)[lang];
            const hasCover = Boolean(post.cover_image);
            const category = categoryName(post, lang);
            return (
              <li class={`featured-post featured-post-${index + 1}`}>
                <a href={blogPath(lang, post.slug)} data-reveal>
                  <figure>
                    <img
                      src={hasCover ? post.cover_image : photos.praise}
                      alt={hasCover ? translation.title : t.photos.praise}
                      loading="lazy"
                    />
                  </figure>
                  <div class="featured-post-body">
                    <p class="featured-post-meta">
                      {category && <span>{category}</span>}
                      <time datetime={post.published_at}>{featuredDateFormatter.format(new Date(post.published_at))}</time>
                    </p>
                    <h3>{translation.title}</h3>
                    {translation.excerpt && <p class="featured-post-excerpt">{translation.excerpt}</p>}
                    <span class="featured-post-read">{t.blog.readMore}<Icon name="arrow-right" size={16} /></span>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <DarkBand label={home.mission.label} title={home.mission.statement}>
    <a class="dark-band-link" href={pathFor('church', lang)}>{home.mission.link} <span aria-hidden="true">&gt;&gt;</span></a>
  </DarkBand>

  <QuickLinks lang={lang} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: max(560px, min(calc(100svh - var(--header-h)), 860px));
    overflow: hidden;
    text-align: center;
  }

  .hero-image {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.38);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 72px;
  }

  .eyebrow {
    color: var(--gold);
  }

  h1 {
    max-width: 15ch;
    margin-top: 18px;
    font-family: var(--display);
    font-size: clamp(2.5rem, 6.6vw, 5.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero-welcome {
    margin-top: 26px;
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.2vw, 1.85rem);
    font-weight: 700;
    text-wrap: balance;
  }

  /* Cada horário é um bloco que não quebra no meio; o "·" entre eles some no celular, onde a linha quebraria sobrando um ponto. */
  .hero-schedule {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.7em;
    row-gap: 2px;
    margin-top: 10px;
    color: var(--gold);
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.2vw, 1.85rem);
    font-weight: 700;
  }

  .hero-schedule span + span::before {
    margin-right: 0.7em;
    content: '·';
  }

  @media (max-width: 640px) {
    .hero-schedule {
      column-gap: 1.1em;
    }

    .hero-schedule span + span::before {
      display: none;
    }
  }

  .hero-intro {
    max-width: 54ch;
    margin: 22px 0 36px;
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    font-weight: 300;
    line-height: 1.55;
  }

  .pillar-band {
    padding: 28px 0 56px;
  }

  .pillar-band ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .pillar-band a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--white);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pillar-band span {
    font-family: var(--script);
    font-size: clamp(2.4rem, 5.6vw, 4.6rem);
    line-height: 1.25;
    letter-spacing: 0.04em;
    word-spacing: 0.18em;
  }

  .pillar-band :global(svg) {
    transition: transform 0.3s ease;
  }

  .pillar-band a:hover {
    color: var(--gold);
  }

  .pillar-band a:hover :global(svg) {
    transform: translateY(6px);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .pillars-list {
    display: grid;
    gap: clamp(3.5rem, 6vw, 5rem);
  }

  .pillar .script {
    margin-top: 12px;
  }

  .pillar .body-text {
    max-width: 540px;
    margin: 16px 0 20px;
  }

  .pillars-photo {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    aspect-ratio: 1 / 1;
    /* Em janelas baixas a foto encolhe em altura, para não ficar cortada embaixo enquanto acompanha a rolagem. */
    max-height: calc(100svh - var(--header-h) - 64px);
    overflow: hidden;
    border-radius: var(--radius-photo);
  }

  .pillars-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-posts {
    overflow: hidden;
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 0 0, rgba(221, 186, 103, 0.2), transparent 28%),
      linear-gradient(122deg, #090909, #17120f);
  }

  .featured-posts-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.62fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .featured-posts .eyebrow {
    color: var(--gold);
  }

  .featured-posts h2 {
    max-width: 12ch;
    margin-top: 12px;
    font-family: var(--display);
    font-size: clamp(2.45rem, 5vw, 4.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.94;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .featured-posts-heading > div:last-child > p {
    max-width: 38ch;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.96rem;
    line-height: 1.6;
  }

  .featured-posts-link {
    margin-top: 20px;
    color: var(--gold);
  }

  .featured-posts-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) repeat(2, minmax(0, 0.8fr));
    gap: clamp(14px, 2vw, 24px);
  }

  .featured-post a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: clamp(20px, 2.5vw, 30px);
    background: rgba(255, 255, 255, 0.05);
    color: var(--white);
    text-decoration: none;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }

  .featured-post a:hover {
    border-color: rgba(221, 186, 103, 0.8);
    background: rgba(255, 255, 255, 0.09);
    transform: translateY(-5px);
  }

  .featured-post figure {
    aspect-ratio: 1 / 0.78;
    overflow: hidden;
  }

  .featured-post-1 figure {
    aspect-ratio: 1 / 0.72;
  }

  .featured-post img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .featured-post a:hover img {
    transform: scale(1.05);
  }

  .featured-post-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(18px, 2.5vw, 28px);
  }

  .featured-post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 12px;
    align-items: center;
    color: var(--gold);
    font-family: var(--display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .featured-post-meta span {
    padding-right: 12px;
    border-right: 1px solid rgba(221, 186, 103, 0.45);
  }

  .featured-post h3 {
    margin-top: 13px;
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.2vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .featured-post-1 h3 {
    font-size: clamp(1.8rem, 3.1vw, 2.75rem);
  }

  .featured-post-excerpt {
    display: -webkit-box;
    margin-top: 12px;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.88rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .featured-post-read {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: auto;
    padding-top: 22px;
    color: var(--gold);
    font-family: var(--display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-post-read :global(svg) {
    transition: transform 0.25s ease;
  }

  .featured-post a:hover .featured-post-read :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .pillars-photo {
      position: static;
      order: -1;
      aspect-ratio: 4 / 3;
      max-height: none;
    }

    .featured-posts-heading,
    .featured-posts-grid {
      grid-template-columns: 1fr;
    }

    .featured-posts-heading {
      gap: 18px;
    }

    .featured-post-1 figure,
    .featured-post figure {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 640px) {
    .pillar-band {
      padding: 12px 0 36px;
    }

    /* Três colunas não comportam a fonte manuscrita no celular: empilha, com a seta ao lado do nome. */
    .pillar-band ul {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .pillar-band li + li {
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }

    .pillar-band a {
      flex-direction: row;
      justify-content: center;
      gap: 14px;
      padding: 10px 0;
    }

    .pillar-band span {
      font-size: 2.5rem;
    }

    .pillar-band :global(svg) {
      width: 28px;
      height: 28px;
      flex: 0 0 auto;
    }
  }
</style>
