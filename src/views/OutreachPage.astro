---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IntroStatement from '../components/IntroStatement.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import NextStep from '../components/NextStep.astro';
import Story from '../components/Story.astro';
import Icon from '../components/Icon.astro';
import { whatsappLink } from '../data/site.js';
import { photos } from '../data/photos.js';
import { getPageData, publicMediaUrl } from '../lib/site-cms.js';

const { lang } = Astro.props;
const cms = await getPageData('outreach', lang);
const { content: t, site: siteData, media } = cms;
const outreach = t.outreach;
// PROVISÓRIO: trocar pelas fotos reais da doação de roupas e da mesa compartilhada.
const blockPhotos = ['praise', 'hallTables'];
const photo = (key) => publicMediaUrl(media.photos?.[key], photos[key]);
const heroMedia = media.hero ?? { type: 'image', src: photos.worship };
---

<BaseLayout lang={lang} page="outreach" contentData={t} siteData={siteData} media={media}>
  <PageHero image={photos.worship} media={heroMedia} titleA={outreach.hero.a} titleB={outreach.hero.b} />
  <IntroStatement title={outreach.statement} text={outreach.intro} />

  <Story>
    {outreach.blocks.map((block, index) => (
      <FeatureBlock {...block} image={photo(blockPhotos[index])} alt={t.photos[blockPhotos[index]]} reverse={index % 2 === 1} />
    ))}
  </Story>

  <NextStep title={outreach.help.title} text={outreach.help.text}>
    <a class="button button-gold" href={whatsappLink(t.ui.whatsappMessage, siteData)} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={20} />{t.ui.whatsapp}</a>
  </NextStep>
</BaseLayout>
