---
// Artigo do blog (/blog/[slug] e os pares em /es e /en). Sob demanda.
// O post chega já validado (publicado e com as três traduções) da rota.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { content } from '../i18n/content.js';
import { defaultLang, languages, blogPath, pathFor } from '../i18n/routes.js';
import { photos } from '../data/photos.js';
import { site } from '../data/site.js';
import { translationsByLang } from '../lib/supabase.js';
import { renderMarkdown } from '../lib/markdown.js';

const { lang, post } = Astro.props;
const t = content[lang];
const translation = translationsByLang(post)[lang];
const hasCover = Boolean(post.cover_image);
const cover = hasCover ? post.cover_image : photos.worship;
const coverAlt = hasCover ? translation.title : t.photos.worship;
const base = Astro.site;
const dateFormatter = new Intl.DateTimeFormat(languages[lang].htmlLang, { day: 'numeric', month: 'long', year: 'numeric' });

// Mesma lógica de canonical e hreflang do BaseLayout, mas com os endereços do post:
// o slug é único e igual nos três idiomas, então só o prefixo muda.
const languagePaths = Object.fromEntries(
  Object.keys(languages).map((code) => [code, blogPath(code, post.slug)]),
);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: translation.title,
  description: translation.seo_description || translation.excerpt || '',
  image: [cover],
  inLanguage: languages[lang].htmlLang,
  datePublished: post.published_at,
  dateModified: translation.updated_at || post.published_at,
  author: { '@type': 'Organization', name: site.name, url: base ? new URL(pathFor('home', lang), base).href : undefined },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: base ? new URL(site.symbol.src, base).href : site.symbol.src },
  },
  mainEntityOfPage: base ? new URL(languagePaths[lang], base).href : languagePaths[lang],
}).replace(/</g, '\\u003c');
---

<BaseLayout
  lang={lang}
  page="blog"
  meta={{
    title: translation.seo_title || translation.title,
    description: translation.seo_description || translation.excerpt || translation.title,
    path: languagePaths[lang],
    languagePaths,
    image: hasCover && base ? { src: cover, alt: coverAlt } : undefined,
    type: 'article',
    publishedTime: post.published_at,
    modifiedTime: translation.updated_at || post.published_at,
    jsonLd,
  }}
>
  <section class="post-hero">
    <img class="post-hero-image" src={cover} alt={coverAlt} fetchpriority="high" />
    <div class="post-hero-content frame">
      <p class="post-date">
        <time datetime={post.published_at}>{dateFormatter.format(new Date(post.published_at))}</time>
      </p>
      <h1>{translation.title}</h1>
    </div>
  </section>

  <article class="section">
    <div class="post frame" data-reveal>
      {translation.excerpt && <p class="lead">{translation.excerpt}</p>}
      <div class="article-body" set:html={renderMarkdown(translation.body)} />
      <a class="arrow-link back" href={blogPath(lang)}><Icon name="arrow-right" size={16} />{t.blog.back}</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: clamp(320px, 42vw, 520px);
    overflow: hidden;
    background: var(--black);
    color: var(--white);
    text-align: center;
  }

  .post-hero-image {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.45);
  }

  .post-hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 900px;
    padding-block: 64px;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.1rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .post-date {
    color: var(--gold);
    font-family: var(--display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .post {
    max-width: 760px;
  }

  .lead {
    margin-bottom: 40px;
    color: var(--muted);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .back {
    display: inline-flex;
    margin-top: 56px;
  }

  .back :global(svg) {
    transform: scaleX(-1);
  }

  .back:hover :global(svg) {
    transform: scaleX(-1) translateX(4px);
  }

  /* Corpo do artigo: Markdown interpretado em src/lib/markdown.js, sem HTML cru. */
  .article-body {
    font-size: 1.09rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .article-body > * + * {
    margin-top: 1.2em;
  }

  .article-body h2 {
    margin-top: 2em;
    font-family: var(--display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .article-body h3 {
    margin-top: 1.8em;
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .article-body h2 + *,
  .article-body h3 + * {
    margin-top: 0.7em;
  }

  .article-body strong {
    color: var(--gold-ink);
    font-weight: 700;
  }

  .article-body a {
    color: var(--gold-ink);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .article-body ul,
  .article-body ol {
    padding-left: 1.4em;
    list-style: revert;
  }

  .article-body li + li {
    margin-top: 0.4em;
  }

  .article-body blockquote {
    padding: 0.2em 0 0.2em 1.4em;
    border-left: 3px solid var(--gold);
    color: var(--muted);
    font-style: italic;
  }

  .article-body blockquote p {
    text-wrap: balance;
  }

  .article-body img {
    width: 100%;
    border-radius: 24px;
    box-shadow: 0 16px 28px rgba(30, 26, 19, 0.12);
  }

  .article-body hr {
    margin-block: 2.4em;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .article-body code {
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--paper);
    font-size: 0.92em;
  }

  .article-body pre {
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--white);
    overflow-x: auto;
  }

  .article-body pre code {
    padding: 0;
    background: none;
  }
</style>
