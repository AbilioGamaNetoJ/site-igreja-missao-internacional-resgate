---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import IntroStatement from '../components/IntroStatement.astro';
import FeatureBlock from '../components/FeatureBlock.astro';
import Story from '../components/Story.astro';
import NextStep from '../components/NextStep.astro';
import { content } from '../i18n/content.js';
import { pathFor } from '../i18n/routes.js';
import { photos } from '../data/photos.js';

const { lang } = Astro.props;
const t = content[lang];
const church = t.church;
const blockPhotos = ['gathering', 'worship', 'facade'];
const galleryPhotos = ['hall', 'praise', 'hallTables', 'congregation'];
---

<BaseLayout lang={lang} page="church">
  <PageHero image={photos.hallTables} titleA={church.hero.a} titleB={church.hero.b} />
  <IntroStatement title={church.statement} text={church.intro} />

  <Story>
    {church.blocks.map((block, index) => (
      <FeatureBlock {...block} image={photos[blockPhotos[index]]} alt={t.photos[blockPhotos[index]]} reverse={index % 2 === 1} variant={index === 1 ? 'panel feature--dark' : 'panel'} />
    ))}
  </Story>

  <section class="gallery section">
    <div class="gallery-head frame" data-reveal>
      <h2>{church.gallery.title}</h2>
      <p>{church.gallery.text}</p>
    </div>
    <div class="gallery-grid frame" data-reveal>
      {galleryPhotos.map((key) => (
        <figure><img src={photos[key]} alt={t.photos[key]} loading="lazy" /></figure>
      ))}
    </div>
  </section>

  <NextStep title={church.next.title} text={church.next.text}>
    <a class="button button-dark" href={pathFor('gatherings', lang)}>{t.ui.seeTimes}</a>
  </NextStep>
</BaseLayout>

<style>
  .gallery {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 18%, rgba(221, 186, 103, 0.34), transparent 20rem),
      #e5e0d8;
  }

  .gallery-head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 44px;
  }

  h2 {
    font-family: var(--display);
    font-size: clamp(2.3rem, 4.8vw, 3.9rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .gallery-head p {
    color: var(--muted);
    font-size: 1.125rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    grid-template-rows: repeat(2, clamp(180px, 22vw, 280px));
    gap: 16px;
  }

  .gallery-grid figure {
    overflow: hidden;
    border: 6px solid rgba(255, 255, 255, 0.78);
    border-radius: 28px;
    box-shadow: 0 16px 28px rgba(30, 26, 19, 0.12);
  }

  .gallery-grid figure:first-child {
    grid-row: span 2;
  }

  .gallery-grid figure:last-child {
    grid-column: span 2;
  }

  .gallery-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .gallery-grid figure:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 760px) {
    .gallery-head {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, 180px);
    }

    .gallery-grid figure:first-child,
    .gallery-grid figure:last-child {
      grid-row: auto;
      grid-column: span 2;
    }
  }
</style>
