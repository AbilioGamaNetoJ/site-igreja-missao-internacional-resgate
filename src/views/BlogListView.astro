---
// Listagem do blog (/blog, /es/blog, /en/blog). Sob demanda: um post publicado
// aparece aqui na hora, sem novo deploy.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogSearch from '../components/BlogSearch.astro';
import Icon from '../components/Icon.astro';
import { content } from '../i18n/content.js';
import { languages, blogPath } from '../i18n/routes.js';
import { photos } from '../data/photos.js';
import { fetchPublishedPosts, translationsByLang, categoryName } from '../lib/supabase.js';
import { searchTerms, matchesTerms, postSearchText } from '../lib/search.js';
import { imageSrcSet, imageUrl } from '../lib/images.js';

const { lang } = Astro.props;
const t = content[lang];
const allPosts = await fetchPublishedPosts();

// O filtro só oferece categorias que têm post publicado; um ?category= desconhecido
// cai na listagem completa.
const categoryOptions = [...new Map(allPosts.filter((post) => post.category_info).map((post) => [post.category, categoryName(post, lang)]))]
  .map(([slug, name]) => ({ slug, name }))
  .sort((a, b) => a.name.localeCompare(b.name, languages[lang].htmlLang));
const requested = Astro.url.searchParams.get('category');
const selected = categoryOptions.some((option) => option.slug === requested) ? requested : null;
// Com ?search=, a página vira resultado de busca: os posts encontrados aparecem
// todos na grade, sem a postagem principal (que poderia nem ter relação com a busca).
const search = Astro.url.searchParams.get('search')?.trim() ?? '';
const terms = searchTerms(search, languages[lang].htmlLang);
const matchesSearch = (post) => matchesTerms(postSearchText(post, lang, languages[lang].htmlLang), terms);
const posts = allPosts.filter((post) => (!selected || post.category === selected) && matchesSearch(post));
const primaryPost = search ? null : posts.find((post) => post.is_primary) ?? posts[0] ?? null;
const remainingPosts = primaryPost ? posts.filter((post) => post.id !== primaryPost.id) : [];
const recentPosts = remainingPosts.slice(0, 4);
const morePosts = search ? posts : remainingPosts.slice(4);
const resultsCount = (posts.length === 1 ? t.blog.resultsCount.one : t.blog.resultsCount.other).replace('{count}', posts.length);
const dateFormatter = new Intl.DateTimeFormat(languages[lang].htmlLang, { day: 'numeric', month: 'long', year: 'numeric' });
const cover = (post) => post.cover_image || photos.praise;
const coverImage = (post, width = 1280) => imageUrl(cover(post), { width, aspectRatio: 16 / 9, quality: 68 });
const coverImageSrcSet = (post) => imageSrcSet(cover(post), { aspectRatio: 16 / 9, quality: 68 });
const coverAlt = (post, translation) => post.cover_image ? translation.title : t.photos.praise;
---

<BaseLayout lang={lang} page="blog">
  <section class="blog-list" aria-labelledby="blog-title">
    <div class="frame">
      <header class="blog-heading">
        <p class="eyebrow">{t.nav.blog}</p>
        <h1 id="blog-title">{t.blog.hero.a} <span>{t.blog.hero.b}</span></h1>
        <p>{t.blog.intro}</p>
      </header>

      {allPosts.length > 0 && (
        <div class="toolbar">
          {categoryOptions.length > 1 && (
            <nav class="filters" aria-label={t.blog.filterLabel}>
              <button type="button" class="filters-arrow filters-arrow-prev" aria-label={t.blog.previousCategories}>
                <Icon name="arrow-right" size={16} />
              </button>
              <div class="filters-track">
                <a href={blogPath(lang)} aria-current={selected || search ? undefined : 'page'}>{t.blog.allCategories}</a>
                {categoryOptions.map(({ slug, name }) => (
                  <a href={`${blogPath(lang)}?category=${encodeURIComponent(slug)}`} aria-current={selected === slug ? 'page' : undefined}>
                    {name}
                  </a>
                ))}
              </div>
              <button type="button" class="filters-arrow filters-arrow-next" aria-label={t.blog.nextCategories}>
                <Icon name="arrow-right" size={16} />
              </button>
            </nav>
          )}
          <BlogSearch lang={lang} posts={allPosts} value={search} />
        </div>
      )}

      {search && (
        <header class="search-summary">
          <h2 id="search-results-title">{t.blog.resultsFor} “{search}”</h2>
          <p>{resultsCount}</p>
          <a href={blogPath(lang)}>{t.blog.clearSearch}</a>
        </header>
      )}

      {posts.length === 0 ? (
        <p class="empty">{search ? t.blog.noResults : t.blog.empty}</p>
      ) : (
        <Fragment>
          {primaryPost && (
            <div class="editorial-grid">
              {(() => {
                const translation = translationsByLang(primaryPost)[lang];
                const category = categoryName(primaryPost, lang);
                return (
                  <article class="primary-post">
                    <a href={blogPath(lang, primaryPost.slug)}>
                      <figure>
                        <img src={coverImage(primaryPost)} srcset={coverImageSrcSet(primaryPost)} sizes="(max-width: 860px) calc(100vw - 40px), 65vw" width="1280" height="720" alt={coverAlt(primaryPost, translation)} fetchpriority="high" decoding="async" />
                        <figcaption>
                          <p class="post-meta">
                          {category && <span>{category}</span>}
                          <time datetime={primaryPost.published_at}>{dateFormatter.format(new Date(primaryPost.published_at))}</time>
                          </p>
                          <h2>{translation.title}</h2>
                        </figcaption>
                      </figure>
                    </a>
                  </article>
                );
              })()}

              {recentPosts.length > 0 && (
                <aside class="recent-posts" aria-labelledby="recent-posts-title">
                  <h2 id="recent-posts-title">{t.blog.recentPosts}</h2>
                  <ol>
                    {recentPosts.map((post) => {
                      const translation = translationsByLang(post)[lang];
                      const category = categoryName(post, lang);
                      return (
                        <li>
                          <a href={blogPath(lang, post.slug)}>
                            <span class="recent-media">
                              <img src={coverImage(post, 480)} srcset={coverImageSrcSet(post)} sizes="112px" width="480" height="270" alt={coverAlt(post, translation)} loading="lazy" decoding="async" />
                            </span>
                            <span>
                              {category && <small>{category}</small>}
                              <strong>{translation.title}</strong>
                              <time datetime={post.published_at}>{dateFormatter.format(new Date(post.published_at))}</time>
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ol>
                </aside>
              )}
            </div>
          )}

          {morePosts.length > 0 && (
            <section class={search ? 'search-results' : 'more-posts'} aria-labelledby={search ? 'search-results-title' : 'more-posts-title'}>
              {!search && <h2 id="more-posts-title">{t.blog.morePosts}</h2>}
              <ul class="post-grid">
                {morePosts.map((post) => {
                  const translation = translationsByLang(post)[lang];
                  const category = categoryName(post, lang);
                  return (
                    <li>
                      <a class="post-card" href={blogPath(lang, post.slug)}>
                        <figure>
                          <img src={coverImage(post, 768)} srcset={coverImageSrcSet(post)} sizes="(max-width: 600px) calc(100vw - 40px), 30vw" width="768" height="432" alt={coverAlt(post, translation)} loading="lazy" decoding="async" />
                        </figure>
                        <div>
                          <p class="post-meta">
                            {category && <span>{category}</span>}
                            <time datetime={post.published_at}>{dateFormatter.format(new Date(post.published_at))}</time>
                          </p>
                          <h3>{translation.title}</h3>
                          {translation.excerpt && <p class="excerpt">{translation.excerpt}</p>}
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
        </Fragment>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // No celular a faixa mostra três categorias. As setas circulam: no fim, a
  // da direita volta ao início, e no início a da esquerda vai ao fim.
  const mobileFilters = window.matchMedia('(max-width: 600px)');
  const visibleCategories = 3;

  const bootCategoryFilters = () => {
    document.querySelectorAll('.filters').forEach((nav) => {
      if (nav.dataset.bound) return;
      nav.dataset.bound = 'true';
      const track = nav.querySelector('.filters-track');
      const previous = nav.querySelector('.filters-arrow-prev');
      const next = nav.querySelector('.filters-arrow-next');
      if (!track || !previous || !next) return;

      const links = () => [...track.querySelectorAll('a')];
      const gap = () => Number.parseFloat(getComputedStyle(track).columnGap) || 0;
      const motion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      const itemLeft = (link) => link.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
      let page = 0;

      const show = (index, behavior = 'auto') => {
        const items = links();
        if (!mobileFilters.matches || items.length === 0) {
          track.style.maxWidth = '';
          previous.disabled = true;
          next.disabled = true;
          return;
        }
        const visible = Math.min(visibleCategories, items.length);
        const lastStart = Math.max(0, items.length - visible);
        const span = lastStart + 1;
        page = ((index % span) + span) % span;
        const shown = items.slice(page, page + visible);
        const desired = shown.reduce((sum, link, position) => sum + link.offsetWidth + (position ? gap() : 0), 0) + 4;
        const gridGap = Number.parseFloat(getComputedStyle(nav).columnGap) || 0;
        const available = nav.clientWidth - previous.offsetWidth - next.offsetWidth - gridGap * 2;
        track.style.maxWidth = `${Math.min(Math.ceil(desired), Math.max(available, 0))}px`;
        track.scrollTo({ left: itemLeft(items[page]), behavior });
        const canMove = lastStart > 0;
        previous.disabled = !canMove;
        next.disabled = !canMove;
      };

      const settle = () => {
        if (!mobileFilters.matches) return;
        const items = links();
        const nearest = items.reduce((best, link, index) => {
          const distance = Math.abs(itemLeft(link) - track.scrollLeft);
          return distance < best.distance ? { index, distance } : best;
        }, { index: 0, distance: Infinity });
        const visible = Math.min(visibleCategories, items.length);
        show(Math.min(nearest.index, Math.max(0, items.length - visible)), 'auto');
      };

      previous.addEventListener('click', () => show(page - 1, motion()));
      next.addEventListener('click', () => show(page + 1, motion()));
      track.addEventListener('scrollend', settle);

      const layout = () => {
        const items = links();
        const current = items.findIndex((link) => link.getAttribute('aria-current') === 'page');
        show(current >= 0 ? current : 0);
      };

      layout();
      document.fonts?.ready.then(layout);
      mobileFilters.addEventListener('change', layout);
      window.addEventListener('resize', layout);
    });
  };

  bootCategoryFilters();
</script>

<style>
  .blog-list { padding-block: clamp(2.75rem, 5vw, 4.75rem) clamp(3.5rem, 6vw, 6rem); }

  .blog-heading { max-width: 720px; margin-bottom: clamp(1.75rem, 3vw, 2.75rem); }

  .eyebrow { margin-bottom: 8px; color: var(--gold-ink); }

  .blog-heading h1 {
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .blog-heading h1 span { color: var(--gold-ink); }

  .blog-heading > p:last-child {
    max-width: 58ch;
    margin-top: 14px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 28px;
    margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
    padding-block: 12px;
    border-block: 1px solid var(--line);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 18px;
  }

  .filters-track {
    display: contents;
  }

  .filters-arrow {
    display: none;
    flex: 0 0 auto;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .filters-arrow:hover,
  .filters-arrow:focus-visible {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .filters-arrow:disabled {
    background: var(--white);
    border-color: var(--line);
    color: var(--muted);
    opacity: 0.4;
    cursor: default;
  }

  .filters-arrow-prev :global(svg) {
    transform: scaleX(-1);
  }

  .toolbar > :global(.blog-search) { flex: 0 1 320px; margin-left: auto; }

  .search-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
    padding-top: 12px;
    border-top: 2px solid var(--ink);
  }

  .search-summary h2 {
    font-family: var(--display);
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .search-summary p { color: var(--muted); font-size: 0.86rem; }

  .search-summary a {
    margin-left: auto;
    color: var(--gold-ink);
    font-family: var(--display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-underline-offset: 4px;
  }

  .search-summary + .empty { border-top: 0; }

  .filters a {
    color: var(--muted);
    font-family: var(--display);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .filters a:hover,
  .filters a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--gold-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .empty {
    padding: 24px 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.85fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }

  .primary-post > a,
  .post-card,
  .recent-posts a { color: var(--ink); text-decoration: none; }

  .primary-post,
  .post-grid li,
  .recent-posts li {
    position: relative;
  }

  .primary-post > a,
  .post-card,
  .recent-posts a {
    display: block;
    transition: transform 0.35s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .primary-post:hover,
  .post-grid li:hover,
  .recent-posts li:hover {
    z-index: 2;
  }

  .primary-post > a:hover,
  .post-card:hover,
  .recent-posts a:hover {
    transform: scale(1.05);
  }

  .primary-post figure {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: var(--paper);
  }

  .primary-post figure::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.34) 46%, transparent 72%);
    content: '';
    pointer-events: none;
  }

  .primary-post img,
  .post-card img,
  .recent-posts img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .primary-post figcaption {
    position: absolute;
    z-index: 1;
    right: clamp(16px, 3vw, 28px);
    bottom: clamp(16px, 3vw, 24px);
    left: clamp(16px, 3vw, 28px);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5px 10px;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .post-meta > * + *::before { margin-right: 10px; color: var(--gold-ink); content: '•'; }

  .primary-post .post-meta { color: rgba(255, 255, 255, 0.82); }
  .primary-post .post-meta > * + *::before { color: var(--gold); }

  .primary-post h2 {
    max-width: 22ch;
    margin-top: 8px;
    font-family: var(--display);
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
    color: var(--white);
  }

  .excerpt { color: var(--muted); font-size: 0.92rem; line-height: 1.55; }

  .recent-posts { border-top: 2px solid var(--ink); }

  .recent-posts h2,
  .more-posts > h2 {
    margin: 12px 0;
    font-family: var(--display);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .recent-posts ol { margin: 0; padding: 0; list-style: none; }
  .recent-posts li { border-top: 1px solid var(--line); }

  .recent-posts a {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding-block: 12px;
    transform-origin: left center;
  }

  .recent-media {
    overflow: hidden;
    border-radius: 8px;
  }

  .recent-posts img { aspect-ratio: 1 / 1; }
  .recent-posts a > span { display: grid; gap: 3px; }

  .recent-posts small {
    color: var(--gold-ink);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .recent-posts strong {
    display: -webkit-box;
    overflow: hidden;
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.12;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .recent-posts time { color: var(--muted); font-size: 0.7rem; line-height: 1.2; }

  .post-card:hover h3,
  .recent-posts a:hover strong { color: var(--gold-ink); }

  .more-posts {
    margin-top: clamp(2.75rem, 5vw, 4.75rem);
    padding-top: 12px;
    border-top: 2px solid var(--ink);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(18px, 2.5vw, 30px);
  }

  .post-card figure {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 10px;
    background: var(--paper);
  }

  .post-card > div { padding-top: 12px; }

  .post-card h3 {
    margin-top: 7px;
    font-family: var(--display);
    font-size: clamp(1.2rem, 1.9vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .post-card .excerpt {
    display: -webkit-box;
    margin-top: 8px;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 820px) {
    .editorial-grid { grid-template-columns: 1fr; }
    .recent-posts ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }
    .recent-posts li { min-width: 0; }
    .recent-posts a { grid-template-columns: 64px minmax(0, 1fr); }
    .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .blog-list { padding-block: 36px 56px; }
    .toolbar { justify-content: center; }
    .toolbar > :global(.blog-search) { flex-basis: 100%; }

    .filters {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 6px;
      width: 100%;
    }

    .filters-arrow { display: grid; }

    .filters-track {
      position: relative;
      justify-self: center;
      display: flex;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 10px;
      width: max-content;
      min-width: 0;
      max-width: 100%;
      padding-block: 4px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x;
    }

    .filters-track::-webkit-scrollbar { display: none; }

    .filters-track a {
      flex: 0 0 auto;
      font-size: 0.75rem;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .recent-posts ol,
    .post-grid { grid-template-columns: 1fr; }
    .recent-posts a { grid-template-columns: 82px minmax(0, 1fr); }
    .post-card { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 12px; }
    .post-card figure { aspect-ratio: 1 / 1; }
    .post-card > div { padding-top: 0; }
    .post-card .excerpt { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-post > a,
    .post-card,
    .recent-posts a {
      transition: none;
    }

    .primary-post > a:hover,
    .post-card:hover,
    .recent-posts a:hover {
      transform: none;
    }
  }
</style>
