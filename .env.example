# Credenciais locais do Wrangler (`bun run deploy`).
# Copie este arquivo para .env e preencha os valores.
# O deploy pelo GitHub Actions usa os secrets do repositório, não este arquivo.

# ID da conta no painel da Cloudflare.
CLOUDFLARE_ACCOUNT_ID=

# Token com a permissão Edit Cloudflare Workers, limitado a esta conta.
# Crie em https://dash.cloudflare.com/?to=/:account/api-tokens
CLOUDFLARE_API_TOKEN=
