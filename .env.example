# Credenciais locais do Wrangler (`bun run deploy`).
# Copie este arquivo para .env e preencha os valores.
# O deploy pelo GitHub Actions usa os secrets do repositório, não este arquivo.

# ID da conta no painel da Cloudflare.
CLOUDFLARE_ACCOUNT_ID=

# Token com a permissão Edit Cloudflare Workers, limitado a esta conta.
# Crie em https://dash.cloudflare.com/?to=/:account/api-tokens
CLOUDFLARE_API_TOKEN=

# Blog (Supabase). As duas chaves entram no build (prefixo PUBLIC_): a URL do
# projeto e a chave anônima, que é pública por natureza — quem protege os dados
# é a RLS do banco (supabase/schema.sql). Preencha também no .dev.vars, para o
# `astro dev`, e nos secrets do GitHub Actions, para o deploy.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: a chave da DeepL (DEEPL_API_KEY) NÃO vai aqui. O .env é lido só no
# build, e ela é um secret de runtime do Worker. Ela fica no .dev.vars para
# desenvolver (copie o .dev.vars.example) e no secret DEEPL_API_KEY do GitHub
# Actions, que o workflow publica no Worker a cada deploy.
# DEEPL_API_KEY=
